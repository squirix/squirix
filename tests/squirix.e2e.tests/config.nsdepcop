<?xml version="1.0" encoding="utf-8"?>
<!--
  Squirix.E2ETests dependency policy.

  End-to-end tests exercise the exported v0.1 client surface. Most suites use in-process
  TestKit hosts; the Smoke suite starts the built host in a separate process and has no
  access to server or TestKit namespaces. Direct server library internals are off-limits.

  Internal layout (child → parent is implicit, so the rules below also cut edges to the root):

    E2ETests (root)            → Fixtures only
    E2ETests.Cache.MultiNode   → own subtree + Fixtures
    E2ETests.Cache.SingleNode  → own subtree + Fixtures
    E2ETests.Cluster           → own subtree + Fixtures
    E2ETests.Smoke             → own subtree + Fixtures.ProcessHosting only
    E2ETests.Fixtures.*        → no test area (shared hosts, clients, and helpers live here)
-->
<NsDepCopConfig IsEnabled="true"
                ChildCanDependOnParentImplicitly="true"
                CheckAssemblyDependencies="true">

  <Allowed From="*" To="*" />
  <AllowedAssembly From="*" To="*" />

  <!-- Direct server assembly reference arrives transitively via TestKit; namespace rule below
       still restricts actual usage to TestKit.* namespaces only. -->
  <DisallowedAssembly From="Squirix.E2ETests" To="Squirix.Server.Host" />
  <DisallowedAssembly From="Squirix.E2ETests" To="Squirix.ProtocolModel" />

  <!-- Server surface is reachable only via TestKit.* namespaces. -->
  <Disallowed From="/^Squirix\.E2ETests(?:\.|$)/" To="/^Squirix\.Server(?:\.(?!TestKit(?:\.|$)).*)?$/" />

  <!-- Public client surface only: client internals stay out of scope. -->
  <Disallowed From="/^Squirix\.E2ETests(?:\.|$)/" To="/^Squirix\.Internal(?:\.|$)/" />

  <!-- ═══ Test-internal isolation ═══ -->

  <!-- Shared fixtures must not depend on the tests that consume them. -->
  <Disallowed
      From="Squirix.E2ETests.Fixtures.*"
      To="/^Squirix\.E2ETests(?:\.(?!Fixtures(?:\.|$)).*)?$/" />

  <!-- Test areas depend only on their own subtree and Fixtures, never on sibling areas or the root. -->
  <Disallowed
      From="Squirix.E2ETests.Cache.MultiNode.*"
      To="/^Squirix\.E2ETests(?:\.(?!(?:Cache\.MultiNode|Fixtures)(?:\.|$)).*)?$/" />
  <Disallowed
      From="Squirix.E2ETests.Cache.SingleNode.*"
      To="/^Squirix\.E2ETests(?:\.(?!(?:Cache\.SingleNode|Fixtures)(?:\.|$)).*)?$/" />
  <Disallowed
      From="Squirix.E2ETests.Cluster.*"
      To="/^Squirix\.E2ETests(?:\.(?!(?:Cluster|Fixtures)(?:\.|$)).*)?$/" />

  <!-- Root-level tests may share only Fixtures, not area-specific helpers. -->
  <Disallowed
      From="Squirix.E2ETests"
      To="/^Squirix\.E2ETests\.(?!Fixtures(?:\.|$)).+$/" />

  <!-- Process smoke scenarios use only the exported SDK and their product-free process fixture. -->
  <Disallowed From="Squirix.E2ETests.Smoke.*" To="Squirix.Server.*" />
  <Disallowed From="Squirix.E2ETests.Smoke.*" To="Squirix.Transport.*" />
  <Disallowed From="Squirix.E2ETests.Fixtures.ProcessHosting.*" To="Squirix.Server.*" />
  <Disallowed From="Squirix.E2ETests.Fixtures.ProcessHosting.*" To="Squirix.Transport.*" />
  <Disallowed From="Squirix.E2ETests.Smoke.*"
              To="/^Squirix\.E2ETests(?:$|\.(?!(?:Smoke|Fixtures\.ProcessHosting)(?:\.|$)).*)$/" />
  <Disallowed From="Squirix.E2ETests.Fixtures.ProcessHosting.*"
              To="/^Squirix\.E2ETests(?:$|\.(?!Fixtures\.ProcessHosting(?:\.|$)).*)$/" />

</NsDepCopConfig>
