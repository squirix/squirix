<?xml version="1.0" encoding="utf-8"?>
<!--
  Squirix.Server.SmokeTests dependency policy.

  Smoke tests are black-box: they start real nodes through Squirix.Server.TestKit hosting helpers
  and interact with them over REST/gRPC using Squirix.Transport.Grpc contracts.

  Direct server product namespaces are forbidden, including public contracts and internal types
  inside otherwise public namespaces. Hosting configuration is exposed through TestKit knobs.
  Server marker attributes remain allowed. InternalsVisibleTo is still required for the generated
  gRPC contract types, which are internal to the server assembly; namespace rules enforce isolation.
-->
<NsDepCopConfig IsEnabled="true"
                ChildCanDependOnParentImplicitly="true"
                CheckAssemblyDependencies="true">

  <Allowed From="*" To="*" />

  <AllowedAssembly From="*" To="*" />

  <!-- Client SDK package stays out of server smoke tests. -->
  <DisallowedAssembly From="Squirix.Server.SmokeTests" To="Squirix" />

  <!-- The executable host and the design-time protocol model are not part of the server surface. -->
  <DisallowedAssembly From="Squirix.Server.SmokeTests" To="Squirix.Server.Host" />
  <DisallowedAssembly From="Squirix.Server.SmokeTests" To="Squirix.ProtocolModel" />

  <!-- Client testkit code comes in as linked source, never as an assembly reference. -->
  <DisallowedAssembly From="Squirix.Server.SmokeTests" To="Squirix.TestKit" />

  <Disallowed From="Squirix.Server.SmokeTests.*" To="Squirix.Internal.*" />
  <Disallowed From="Squirix.Server.SmokeTests.*" To="Squirix.Core.*" />

  <!-- Black-box boundary: only smoke-test, TestKit, and marker-attribute namespaces are reachable inside Squirix.Server. -->
  <Disallowed
      From="/^Squirix\.Server\.SmokeTests(?:\.|$)/"
      To="/^Squirix\.Server(?:$|\.(?!(?:SmokeTests|TestKit|Attributes)(?:\.|$)).*)$/" />

</NsDepCopConfig>
