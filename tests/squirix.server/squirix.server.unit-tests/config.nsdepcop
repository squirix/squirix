<?xml version="1.0" encoding="utf-8"?>
<!--
  Squirix.Server.UnitTests dependency policy.

  Unit tests are white-box and may reference any Squirix.Server.* production namespace.
  Guard only the package boundary against the client SDK and direct client namespaces.
-->
<NsDepCopConfig IsEnabled="true"
                ChildCanDependOnParentImplicitly="true"
                CheckAssemblyDependencies="true">

  <Allowed From="*" To="*" />

  <AllowedAssembly From="*" To="*" />

  <DisallowedAssembly From="Squirix.Server.UnitTests" To="Squirix" />

  <Disallowed From="Squirix.Server.UnitTests.*" To="Squirix.Internal.*" />
  <Disallowed From="Squirix.Server.UnitTests.*" To="Squirix.Core.*" />

  <!-- Test-isolation (unit-test-isolation cycle 2): storage unit tests must not
       reach transport adapters or DI/host composition. Node.Services/App collaborators
       stay allowed: storage recovery tests are sociable by design. -->
  <Disallowed From="Squirix.Server.UnitTests.Persistence.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.UnitTests.Persistence.*" To="Squirix.Server.Node.Hosting.*" />

</NsDepCopConfig>
