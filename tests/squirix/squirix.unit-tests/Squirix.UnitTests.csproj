<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Squirix.UnitTests</RootNamespace>
        <AssemblyName>Squirix.UnitTests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="ApiSnapshots\SquirixPublicTypes.golden.txt" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\squirix.testkit\Squirix.TestKit.csproj"/>
        <ProjectReference Include="..\..\..\src\squirix\Squirix.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>Squirix.RepositoryRoot</_Parameter1>
            <_Parameter2>$([System.IO.Path]::GetFullPath('$([System.IO.Path]::Combine($(MSBuildProjectDirectory), '..', '..', '..'))'))</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
    <ItemGroup>
        <Content Include="..\..\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
