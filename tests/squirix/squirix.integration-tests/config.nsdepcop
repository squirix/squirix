<?xml version="1.0" encoding="utf-8"?>
<!--
  Squirix.IntegrationTests dependency policy.

  Client bucket stays free of server-side packages: integration tests exercise
  the exported v0.1 client surface against a locally hosted endpoint.
  White-box coverage of client internals belongs in Squirix.UnitTests.
-->
<NsDepCopConfig IsEnabled="true"
                ChildCanDependOnParentImplicitly="true"
                CheckAssemblyDependencies="true">

  <Allowed From="*" To="*" />
  <AllowedAssembly From="*" To="*" />

  <DisallowedAssembly From="Squirix.IntegrationTests" To="Squirix.Server" />
  <DisallowedAssembly From="Squirix.IntegrationTests" To="Squirix.Server.Host" />
  <DisallowedAssembly From="Squirix.IntegrationTests" To="Squirix.Server.TestKit" />
  <DisallowedAssembly From="Squirix.IntegrationTests" To="Squirix.ProtocolModel" />

  <!-- Exported client surface only: client internals are covered white-box by Squirix.UnitTests. -->
  <Disallowed From="Squirix.IntegrationTests.*" To="Squirix.Internal.*" />

</NsDepCopConfig>
