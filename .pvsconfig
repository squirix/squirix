// PVS-Studio diagnostic configuration for CI and IDE (pvs-studio-dotnet -C / project-linked .pvsconfig).
// Exclude generated and build artifacts from analysis.
// Path masks use * / ? only (no git-style **); directories recurse implicitly.
//V_EXCLUDE_PATH */bin/*
//V_EXCLUDE_PATH */obj/*
//V_EXCLUDE_PATH *.g.cs
//V_EXCLUDE_PATH *.AssemblyInfo.cs
//V_EXCLUDE_PATH */AssemblyInfo.cs
// Keep analysis aligned with the production CI project set (tests/samples/benchmarks out of scope).
//V_EXCLUDE_PATH */tests/*
//V_EXCLUDE_PATH */samples/*
//V_EXCLUDE_PATH */benchmarks/*
//
// Do not globally disable V3163/V5606. Intentional empty dispose/drain/cleanup/shutdown catches
// are marked in-source with False Alarm comments inside the catch body:
//   //-V5606 //-V3163
// (C# in-source //-V:: filters are unsupported; FA marks are the scoped mechanism.)
//
// Reports include remaining groups/levels. CI fails only on GA:1,2 (see .github/workflows/ci.yml).
