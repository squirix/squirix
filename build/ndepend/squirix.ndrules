<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<NDepend>
  <Queries>
    <CustomJustMyCodeQueries>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport types from JustMyCode</Name>
// Share-sourced wire types and protobuf-generated service contracts are not product-layer code.
// Removes Squirix.Transport.Grpc* from JustMyCode for all rules (including ND2016 Try* methods).
notmycode
from t in Types
where t.FullNameLike("Squirix.Transport.Grpc*")
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport methods from JustMyCode</Name>
// Explicit method discard so rules that enumerate Methods (for example ND2016) never see
// protobuf client stubs such as SquirixCacheService+SquirixCacheServiceClient.TryAddEntry.
notmycode
from m in Methods
where m.ParentType != null &&
      m.ParentType.FullNameLike("Squirix.Transport.Grpc*")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport fields from JustMyCode</Name>
notmycode
from f in Fields
where f.ParentType != null &&
      f.ParentType.FullNameLike("Squirix.Transport.Grpc*")
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source types from JustMyCode</Name>
// Exclude Roslyn/tooling *.g.cs, protobuf compiler outputs (Grpc.Tools), and common generated folders.
// Examples: obj/**/SquirixCacheGrpc.cs, obj/**/SquirixCache.cs, **/*.g.cs, **/Generated/**.
// Shared path predicate is duplicated per element kind — NDepend notmycode requires Types, Methods, and Fields separately.
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from t in Types
where t.SourceFileDeclAvailable &&
      t.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source methods from JustMyCode</Name>
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from m in Methods
where m.SourceFileDeclAvailable &&
      m.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source fields from JustMyCode</Name>
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from f in Fields
where f.SourceFileDeclAvailable &&
      f.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard GeneratedCodeAttribute types from JustMyCode</Name>
notmycode
from t in Types
where t.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard GeneratedCodeAttribute methods from JustMyCode</Name>
// Grpc.Tools tags generated RPC stubs on the method (grpc_csharp_plugin), not always on the declaring type.
notmycode
from m in Methods
where m.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard MutableInt holder fields from JustMyCode</Name>
// MutableInt32/MutableInt64._value is mutated via Interlocked through ref; marking it readonly is invalid C#.
notmycode
from f in Fields
where f.ParentType != null &&
      (f.ParentType.FullName == "Squirix.Server.Utils.MutableInt32" ||
       f.ParentType.FullName == "Squirix.Server.Utils.MutableInt64")
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude durability dedicated threads from ND2500</Name>
// JournalCoordinator owns a long-lived WAL I/O thread by design.
// Task.Run is banned on infrastructure paths; do not refactor it to the thread pool.
// Manifest roll publishing now uses a Task (TaskCreationOptions.LongRunning) and no longer
// creates a raw Thread, so it is not excluded here.
notmycode
from m in Methods
where m.IsConstructor &&
      m.ParentType != null &&
      m.ParentType.FullName == "Squirix.Server.Storage.Journaling.JournalCoordinator"
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude compiler-generated collection helpers</Name>
// Collection expressions synthesize <>z__ReadOnly* types that throw reserved exception types.
notmycode
from t in Types
where t.IsGeneratedByCompiler || t.Name.StartsWith("<>z__")
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude compiler-generated collection methods</Name>
notmycode
from m in Methods
where m.ParentType != null &&
      (m.ParentType.IsGeneratedByCompiler || m.ParentType.Name.StartsWith("<>z__"))
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude JournalSegmentPolicy from class-to-struct suggestion</Name>
// Sealed reference type keeps Policy property semantics simple; struct conversion fights MA0008/RCS1085.
notmycode
from t in Types
where t.FullName == "Squirix.Server.Storage.Journaling.JournalSegmentPolicy"
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude CreateHashLocator offline tool entry</Name>
// Used by tools/sqr-ring-distribution.cs (file-based app outside analyzed assemblies).
notmycode
from m in Methods
where m.FullName == "Squirix.Server.Cluster.RuntimeServiceRegistration.CreateHashLocator(ReadOnlySpan<String>,Int32)"
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard sample assemblies from JustMyCode</Name>
// Smoke/sample apps under samples/ are not product-layer code. Folder layout need not match
// RootNamespace (ND2103) and other naming rules should not gate sample harnesses.
notmycode
from a in Application.Assemblies.WithNameIn(
      "ExternalPackageSmoke")
select a]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard analyzers assembly from multi-version / cohesion noise</Name>
// Analyzers ship Roslyn packages that intentionally differ from app TFM analysis graphs.
notmycode
from a in Application.Assemblies.WithNameIn("Squirix.Analyzers")
select a]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard unit-test assemblies from cohesion / SCA gates</Name>
// Test harness cohesion and transitive SCA hits are not product-layer debt.
notmycode
from a in Application.Assemblies.WithNameIn(
      "Squirix.UnitTests",
      "Squirix.Server.UnitTests",
      "Squirix.Server.TestKit",
      "Squirix.TestKit",
      "Squirix.IntegrationTests",
      "Squirix.Server.IntegrationTests",
      "Squirix.Server.SmokeTests",
      "Squirix.E2ETests",
      "Squirix.Benchmarks",
      "Squirix.Server.Benchmarks",
      "Squirix.E2EBenchmarks")
select a]]></Query>
    </CustomJustMyCodeQueries>
    <CustomRuleOverrides>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND2500" Group="System.Threading"><![CDATA[// <Name>Don't create threads explicitly</Name>
// <Id>ND2500:DontCreateThreadsExplicitly</Id>
// ND2500 squirix override: durability WAL/manifest publishers own dedicated I/O threads by design
// (excluded via notmycode "Exclude durability dedicated threads from ND2500").
warnif count > 0
from m in JustMyCode.Methods
where m.CreateA("TYPE:System.Threading.Thread".AllowNoMatch())
select new { m, Debt = 30.ToMinutes().ToDebt(), Severity = Severity.High }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND2016" Group="Naming Conventions"><![CDATA[// <Name>Methods prefixed with 'Try' should return a boolean</Name>
// <Id>ND2016:MethodsPrefixedWithTryShouldReturnABoolean</Id>
// ND2016 squirix override: stock rule uses Application.Methods and ignores notmycode.
// JustMyCode excludes protobuf/gRPC generated Try* RPC stubs via notmycode queries above.
warnif count > 0
from m in JustMyCode.Methods
where m.SimpleNameLike("^Try") &&
      m.ReturnType != null &&
      m.ReturnType.FullName != "System.Boolean" &&
      !m.ReturnType.Name.Contains("Task")
select new { m, m.ReturnType, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>
      <Query Active="False" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND2802" Group="System.Reflection"><![CDATA[// <Name>Avoid mixing different versions of the same assembly (ND2802)</Name>
// <Id>ND2802:AssembliesReferencedInMultipleVersions</Id>
// ND2802 squirix override (disabled): .NET SDK emits multi-version facade references for Roslyn/xUnit
// during analyzers-only restore (benign, not loaded at runtime). Rule disabled as false-positive.
warnif count > 0
from assembly in Application.Assemblies
from @using in assembly.AssembliesUsed
where assembly.Name == @using.Name && @using.Version != assembly.Version
select new { assembly, @using }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND1305" Group="Design"><![CDATA[// <Name>Avoid namespaces with few types</Name>
// <Id>ND1305:AvoidNamespacesWithFewTypes</Id>
// ND1305 squirix override: count only non-generated (real) types per namespace.
// Autogenerated namespaces (gRPC/protobuf/tools *.g.cs) are excluded from the
// decomposition heuristic. Squirix.Client is the exported v0.1 client surface
// (intentionally small public API) and is also excluded.
warnif count > 0
from n in Application.Namespaces
where n.Name != "Squirix.Client" && !n.Name.Contains(".Grpc.")
let realTypeCount = JustMyCode.Types.Count(t => t.ParentNamespace != null && t.ParentNamespace.FullName == n.FullName)
where realTypeCount > 0 && realTypeCount <= 3
select new { n, RealTypeCount = realTypeCount, Debt = 5.ToMinutes().ToDebt(), Severity = Severity.Low }]]></Query>
    </CustomRuleOverrides>
  </Queries>
</NDepend>
