<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<NDepend>
  <Queries>
    <CustomJustMyCodeQueries>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport types from JustMyCode</Name>
// Share-sourced wire types and protobuf-generated service contracts are not product-layer code.
// Removes Squirix.Transport.Grpc* from JustMyCode for all rules (including ND2016 Try* methods).
notmycode
from t in Types
where t.FullNameLike("Squirix.Transport.Grpc*")
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport methods from JustMyCode</Name>
// Explicit method discard so rules that enumerate Methods (for example ND2016) never see
// protobuf client stubs such as SquirixCacheService+SquirixCacheServiceClient.TryAddEntry.
notmycode
from m in Methods
where m.ParentType != null &&
      m.ParentType.FullNameLike("Squirix.Transport.Grpc*")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport fields from JustMyCode</Name>
notmycode
from f in Fields
where f.ParentType != null &&
      f.ParentType.FullNameLike("Squirix.Transport.Grpc*")
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source types from JustMyCode</Name>
// Exclude Roslyn/tooling *.g.cs, protobuf compiler outputs (Grpc.Tools), and common generated folders.
// Examples: obj/**/SquirixCacheGrpc.cs, obj/**/SquirixCache.cs, **/*.g.cs, **/Generated/**.
// Shared path predicate is duplicated per element kind — NDepend notmycode requires Types, Methods, and Fields separately.
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from t in Types
where t.SourceFileDeclAvailable &&
      t.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source methods from JustMyCode</Name>
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from m in Methods
where m.SourceFileDeclAvailable &&
      m.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source fields from JustMyCode</Name>
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from f in Fields
where f.SourceFileDeclAvailable &&
      f.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard GeneratedCodeAttribute types from JustMyCode</Name>
notmycode
from t in Types
where t.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard GeneratedCodeAttribute methods from JustMyCode</Name>
// Grpc.Tools tags generated RPC stubs on the method (grpc_csharp_plugin), not always on the declaring type.
notmycode
from m in Methods
where m.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard MutableInt holder fields from JustMyCode</Name>
// MutableInt32/MutableInt64._value is mutated via Interlocked through ref; marking it readonly is invalid C#.
notmycode
from f in Fields
where f.ParentType != null &&
      (f.ParentType.FullName == "Squirix.Server.Utils.MutableInt32" ||
       f.ParentType.FullName == "Squirix.Server.Utils.MutableInt64")
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude durability dedicated threads from ND2500</Name>
// JournalCoordinator and ManifestRollPublisher own long-lived WAL/manifest I/O threads by design.
// Task.Run is banned on infrastructure paths; do not refactor these to the thread pool.
notmycode
from m in Methods
where m.IsConstructor &&
      m.ParentType != null &&
      (m.ParentType.FullName == "Squirix.Server.Storage.Journaling.JournalCoordinator" ||
       m.ParentType.FullName == "Squirix.Server.Storage.ManifestRollPublisher")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude ExceptionExpectation helpers from ND1208</Name>
// CA1000 / MA0018 forbid static members on generic types; instance Throws helpers are intentional.
notmycode
from m in Methods
where m.ParentType != null &&
      m.ParentType.SimpleName.EndsWith("ExceptionExpectation")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude compiler-generated collection helpers</Name>
// Collection expressions synthesize <>z__ReadOnly* types that throw reserved exception types.
notmycode
from t in Types
where t.IsGeneratedByCompiler || t.NameLike("^<>z__")
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude compiler-generated collection methods</Name>
notmycode
from m in Methods
where m.ParentType != null &&
      (m.ParentType.IsGeneratedByCompiler || m.ParentType.NameLike("^<>z__"))
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude CapturedMeasurement equality operators from ND1701</Name>
// Operators exist to satisfy value-type equality rules; call sites use Equals directly.
notmycode
from m in Methods
where m.IsOperator &&
      m.ParentType != null &&
      m.ParentType.Name == "CapturedMeasurement" &&
      (m.SimpleName == "op_Equality" || m.SimpleName == "op_Inequality")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude JournalSegmentPolicy from class-to-struct suggestion</Name>
// Sealed reference type keeps Policy property semantics simple; struct conversion fights MA0008/RCS1085.
notmycode
from t in Types
where t.FullName == "Squirix.Server.Storage.Journaling.JournalSegmentPolicy"
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude CreateHashLocator offline tool entry</Name>
// Used by tools/sqr-ring-distribution.cs (file-based app outside analyzed assemblies).
notmycode
from m in Methods
where m.FullName == "Squirix.Server.Cluster.RuntimeServiceRegistration.CreateHashLocator(ReadOnlySpan<String>,Int32)"
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard sample assemblies from JustMyCode</Name>
// Smoke/sample apps under samples/ are not product-layer code. Folder layout need not match
// RootNamespace (ND2103) and other naming rules should not gate sample harnesses.
notmycode
from a in Application.Assemblies.WithNameIn(
      "ExternalPackageSmoke")
select a]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard analyzers assembly from multi-version / cohesion noise</Name>
// Analyzers ship Roslyn packages that intentionally differ from app TFM analysis graphs.
notmycode
from a in Application.Assemblies.WithNameIn("Squirix.Analyzers")
select a]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard unit-test assemblies from cohesion / SCA gates</Name>
// Test harness cohesion and transitive SCA hits are not product-layer debt.
notmycode
from a in Application.Assemblies.WithNameIn(
      "Squirix.UnitTests",
      "Squirix.Server.UnitTests",
      "Squirix.Server.TestKit",
      "Squirix.TestKit",
      "Squirix.IntegrationTests",
      "Squirix.Server.IntegrationTests",
      "Squirix.Server.SmokeTests",
      "Squirix.E2ETests",
      "Squirix.Benchmarks",
      "Squirix.Server.Benchmarks",
      "Squirix.E2EBenchmarks")
select a]]></Query>
    </CustomJustMyCodeQueries>
    <CustomRuleOverrides>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND2016" Group="Naming Conventions"><![CDATA[// <Name>Methods prefixed with 'Try' should return a boolean</Name>
// <Id>ND2016:MethodsPrefixedWithTryShouldReturnABoolean</Id>
// ND2016 squirix override: stock rule uses Application.Methods and ignores notmycode.
// JustMyCode excludes protobuf/gRPC generated Try* RPC stubs via notmycode queries above.
warnif count > 0
from m in JustMyCode.Methods
where m.SimpleNameLike("^Try") &&
      m.ReturnType != null &&
      m.ReturnType.FullName != "System.Boolean" &&
      !m.ReturnType.Name.Contains("Task")
select new { m, m.ReturnType, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND1902" Group="Immutability"><![CDATA[// <Name>Avoid static fields with a mutable field type</Name>
// <Id>ND1902:AvoidStaticFieldsWithAMutableFieldType</Id>
// ND1902 squirix override: stock rule uses Application.Fields and ignores notmycode.
// Explicit FullName exclusions for intentional process-wide static cells (notmycode alone is unreliable for Fields).
warnif count > 0
from f in JustMyCode.Fields
where f.IsStatic &&
     !f.IsEnumValue &&
     !f.IsGeneratedByCompiler &&
     !f.IsLiteral
let fieldType = f.FieldType
let isExcludedStaticHolder =
     f.FullNameLike("(.*\\.)?IdempotencyMetrics\\.Catalog$") ||
     f.FullNameLike("(.*\\.)?MemoryPressureMetrics\\.Catalog$") ||
     f.FullName == "Squirix.Server.Node.Observability.BackpressureMetrics.Observers" ||
     f.FullName == "Squirix.Server.Node.Observability.BackpressureMetrics.ObserversState" ||
     f.FullName == "Squirix.Server.Node.MemoryPressure.ObjectCacheEntrySizeEstimator.NullPayloadShell" ||
     f.FullName == "Squirix.Server.TestKit.MockOidcAuthority.PortPool" ||
     f.FullName == "Squirix.Server.TestKit.Mtls.ClusterTls+InternalPortPool.Allocator"
where fieldType != null &&
     !fieldType.IsThirdParty &&
     !fieldType.IsInterface &&
     !fieldType.IsDelegate &&
     !fieldType.IsImmutable &&
     !isExcludedStaticHolder
select new {
   f,
   mutableFieldType = fieldType,
   isFieldImmutable = f.IsImmutable ? "Immutable" : "Mutable",
   isFieldReadOnly = f.IsInitOnly ? "ReadOnly" : "Not ReadOnly",
   Debt = 10.ToMinutes().ToDebt(),
   Severity = Severity.Medium
}]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND1305" Group="Design"><![CDATA[// <Name>Avoid namespaces with few types</Name>
// <Id>ND1305:AvoidNamespacesWithFewTypes</Id>
// ND1305 squirix override: stock infra list plus "Client" for the intentional
// exported Squirix.Client entry surface (ISquirixClient / SquirixClient / Options).
// Merging that namespace would break the public API golden contract.
// Also skip *Benchmarks* namespaces — BDN folders intentionally stay small.
warnif count > 0

let infraNamespaceNames = new HashSet<string>() {
      "Services", "Exceptions", "Logging",  "Domain",
      "Identity",  "Migrations",  "Controllers",
      "Specifications",  "Interfaces",  "Components",
      "Bus",  "Models",  "EventHandlers",  "Mappings",
      "ViewModels",  "ViewComponents",  "Notifications",
      "Configurations",  "Extensions",  "Events",
      "Context",  "Data",  "EventSourcing",  "Repository",
      "IoC",  "Manage",  "Commands",  "CommandHandlers",
      "Validations",  "EventStoreSQL",  "Authorization",
      "Formatters",  "Xml",  "Json",  "Enums",
      "Abstractions",  "BaseClasses",  "Settings",
      "Helpers",  "Validators",  "Entities",  "Pages",
      "Client",
      "Rest", "Errors", "Endpoint", "Internal", "Cluster",
      "Observability", "Support", "Networking", "Utils", "Memory",
      "Persistence", "Adapters", "Core", "Hosting", "ApiSnapshots",
      "Diagnostics", "Invocation"
}

from a in JustMyCode.Assemblies
where a.NbTypes >= 15

from n in a.ChildNamespaces
where n.Name.Length > 0
 && !n.Name.Contains("Benchmarks")
 && !infraNamespaceNames.Contains(n.SimpleName)
 && !n.ParentNamespaces.Any(pn => infraNamespaceNames.Contains(pn.SimpleName))
 &&  n.Name != n.ParentAssembly.Name
let types = n.ChildTypes.Where(t => !t.IsGeneratedByCompiler).ToArray()
where
   types.Length > 0 &&
   types.Length < 5 &&
   types.All(t => JustMyCode.Contains(t))
   orderby types.Length ascending
select new {
   n,
   types,
   Debt = 5.ToMinutes().ToDebt(),
   Severity = Severity.Low
}]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND1206" Group="Object Oriented Design"><![CDATA[// <Name>A stateless class or structure might be turned into a static type</Name>
// <Id>ND1206:AStatelessClassOrStructureMightBeTurnedIntoAStaticType</Id>
// ND1206 squirix override: exclude *Tests types. xUnit does not put a Test attribute
// on the test class itself, so the stock attribute filter still flags them.
warnif count > 0

let testAttributes = ThirdParty.Types
                  .Where(t => t.IsAttributeClass && t.SimpleName.Contains("Test")).ToArray()

from t in JustMyCode.Types where
  !t.IsStatic &&
  !t.IsGeneric &&
  !t.IsAbstract &&
   t.InstanceFields.Count() == 0 &&
   t.SimpleName != "Program" &&
   !t.SimpleName.EndsWith("Tests") &&

   // Don't match:
   // --> types that implement some interfaces.
   t.NbInterfacesImplemented == 0 &&

   // --> or classes that have sub-classes children.
   t.NbChildren == 0 &&

   // --> or classes that have a base class
   ((t.IsClass && t.DepthOfDeriveFrom("System.Object".AllowNoMatch()) == 1) ||
     t.IsStructure) &&

   // Don't match test classes
   !testAttributes.Any(tAttr => t.HasAttribute(tAttr)) &&

   // Don't warn about classes instantiated by Dependency Injection frameworks
   !t.TypesUsingMe.Any(t1 => t1.TypesUsed.ParentNamespaces().Any(n => n.Name.StartsWithAny(
       "Microsoft.Extensions.DependencyInjection",
       "Autofac", "Microsoft.Practices.Unity", "Ninject",
       "StructureMap", "SimpleInjector", "Castle.Windsor",
       "LightInject", "Spring", "Lamar", "AutoMapper"
   ))) &&
   !t.BaseClasses.Any(bc => bc.FullName.StartsWith("AutoMapper")) &&

   // Don't match marker classes
  !(t.IsSealed && t.Members.Count() == 1 &&
    t.Members.Single().IsMethod &&
    t.Members.Single().AsMethod.IsConstructor &&
    t.Members.Single().AsMethod.NbParameters == 0)

let methodsUsingMe = t.TypesUsingMe.ChildMethods().Where(m => m.IsUsing(t))

select new {
   t,
   methodsUsingMe,
   Debt = (1 + methodsUsingMe.Count()).ToMinutes().ToDebt(),
   Severity = Severity.Low
}]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND1207" Group="Object Oriented Design"><![CDATA[// <Name>Non-static classes should be instantiated or turned to static</Name>
// <Id>ND1207:NonStaticClassesShouldBeInstantiatedOrTurnedToStatic</Id>
// ND1207 squirix override: exclude *Tests and *Benchmarks types.
// xUnit does not put a Test attribute on the test class itself, so the stock
// attribute filter still flags them. BenchmarkDotNet instantiates *Benchmarks
// hosts via reflection, so constructors look unused to static analysis.
warnif count > 0

let testAttributes = Types
                  .Where(t => t.IsAttributeClass && t.SimpleName.Contains("Test")).ToArray()

from t in JustMyCode.Types
where  t.IsClass &&
      //!t.IsPublic &&   // if you are developing a framework,
                        // you might not want to match public classes
      !t.IsStatic &&
      !t.IsAbstract &&
      !t.IsDelegate &&
      !t.IsAttributeClass && // Attributes class are never seen as instantiated
      !t.SimpleName.EndsWith("Tests") &&
      !t.SimpleName.EndsWith("Benchmarks") &&

      // Don't suggest to turn to static, classes that implement interfaces
      t.InterfacesImplemented.Count() == 0 &&

      // Find the first constructor of t called
      // match t if none of its constructors is called.
      t.Constructors.FirstOrDefault(ctor => ctor.NbMethodsCallingMe > 0) == null &&

      // Don't warn on Program classes generated by designers
      t.SimpleName != "Program" &&

      // Types instantiated through remoting infrastructure
      !t.DeriveFrom("System.MarshalByRefObject".AllowNoMatch()) &&

      // JSON, XML and binary serialized types might not be seen as instantiated.
      !t.IsUsing("Newtonsoft.Json".MatchNamespace().AllowNoMatch()) &&
      !t.IsUsing("System.Text.Json".MatchNamespace().AllowNoMatch()) &&
      !t.HasAttribute("System.Xml.Serialization.XmlRootAttribute".AllowNoMatch()) &&
      !t.IsUsing("System.Xml.Serialization.XmlElementAttribute".AllowNoMatch()) &&
      !t.IsUsing("System.Xml.Serialization.XmlAttributeAttribute".AllowNoMatch()) &&
      !t.HasAttribute ("System.SerializableAttribute".AllowNoMatch()) &&

      // Serialized type might never be seen as instantiated.
      !t.HasAttribute("System.Runtime.Serialization.DataContractAttribute".AllowNoMatch()) &&
      !t.IsUsing("System.Runtime.Serialization.DataMemberAttribute".AllowNoMatch()) &&

      // ASP.NET Core ViewModel and Repository
      !t.SimpleName.EndsWithAny("Model","Repository") &&
      !t.IsUsing("System.ComponentModel.DataAnnotations".AllowNoMatch().MatchNamespace()) &&

      // ASP.NET Classes that are instantiated by the ASP.NET infrastructure.
      !t.BaseClasses.Any(bc => bc.ParentNamespace.Name.StartsWithAny("System.Web", "Microsoft.AspNetCore"))  &&
      !(t.Constructors.Count() == 1 && t.Constructors.Single().Name.Contains("(IHostingEnvironment)")) &&

      // Entity Framework ModelSnapshot and DbContext and Migration
      !t.DeriveFrom("Microsoft.EntityFrameworkCore.Infrastructure.ModelSnapshot".AllowNoMatch()) &&
      !t.DeriveFrom("Microsoft.EntityFrameworkCore.DbContext".AllowNoMatch()) &&
      !t.DeriveFrom("Microsoft.EntityFrameworkCore.Migrations.Migration".AllowNoMatch()) &&

      // ASP.NET Core Tag Helpers
      !t.HasAttribute("Microsoft.AspNetCore.Razor.TagHelpers.HtmlTargetElementAttribute".AllowNoMatch()) &&
      !t.DeriveFrom("HtmlTags.HtmlTagTagHelper".AllowNoMatch()) &&

      // UWP Pages
      !t.InstanceMethods.WithName("GetBindingConnector(Int32,Object)").Any() &&

      // Don't match test classes
      !testAttributes.Any(tAttr => t.HasAttribute(tAttr)) &&

      // Validtor classes might not be instantiated
      !t.SimpleName.EndsWith("Validator") &&

      // Don't warn about classes instantiated by Dependency Injection frameworks
      !t.TypesUsingMe.Any(t1 => t1.TypesUsed.ParentNamespaces().Any(n => n.Name.StartsWithAny(
            "Microsoft.Extensions.DependencyInjection",
            "Autofac", "Microsoft.Practices.Unity", "Ninject",
            "StructureMap", "SimpleInjector", "Castle.Windsor",
            "LightInject", "Spring", "Lamar", "AutoMapper"
      ))) &&
      !t.BaseClasses.Any(bc => bc.FullName.StartsWith("AutoMapper")) &&

      // Don't warn if the type is used by some types using some third-party Json related types.
      // The type is potentially instantiated by a Json serializer like the GetFromJsonAsync() extension methods.
      !t.TypesUsingMe.SelectMany(t1 => t1.TypesUsed)
                     .Where(t1 => t1.IsThirdParty && t1.SimpleName.Contains("Json")).Any() &&

      // Classes that derive from Unity classes are instantiated implicitly by the Unity engine
      !t.BaseClasses.Any(bc => bc.ParentNamespace.Name.StartsWithAny("UnityEngine","UnityEditor")) &&

      // Don't match marker classes
      !(t.IsSealed && t.Members.Count() == 1 &&
        t.Members.Single().IsMethod &&
        t.Members.Single().AsMethod.IsConstructor &&
        t.Members.Single().AsMethod.NbParameters == 0) &&

      // Roslyn DiagnosticAnalyzers are MEF-instantiated; constructors look unused to static analysis.
      !t.DeriveFrom("Microsoft.CodeAnalysis.Diagnostics.DiagnosticAnalyzer".AllowNoMatch())

select new {
   t,
   t.Visibility,
   Debt = 2.ToMinutes().ToDebt(),
   Severity = Severity.Medium
}]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND2500" Group="System.Threading"><![CDATA[// <Name>Don't create threads explicitly</Name>
// <Id>ND2500:DontCreateThreadsExplicitly</Id>
// ND2500 squirix override: durability WAL/manifest publishers own dedicated I/O threads by design.
warnif count > 0
from m in JustMyCode.Methods
where m.IsUsing("System.Threading.Thread".AllowNoMatch()) &&
      !(m.IsConstructor &&
        m.ParentType != null &&
        (m.ParentType.FullName == "Squirix.Server.Storage.Journaling.JournalCoordinator" ||
         m.ParentType.FullName == "Squirix.Server.Storage.ManifestRollPublisher"))
select new { m, Debt = 30.ToMinutes().ToDebt(), Severity = Severity.High }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND1901" Group="Immutability"><![CDATA[// <Name>Avoid non-readonly static fields</Name>
// <Id>ND1901:AvoidNonReadonlyStaticFields</Id>
// ND1901 squirix override: exclude intentional process-wide mutable static cells.
warnif count > 0
from f in JustMyCode.Fields
where f.IsStatic &&
     !f.IsInitOnly &&
     !f.IsLiteral &&
     !f.IsEnumValue &&
     !f.IsGeneratedByCompiler &&
     f.FullName != "Squirix.Server.Node.Observability.BackpressureMetrics._snapshotBuffer"
select new { f, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False" RuleToken="ND2001" Group="Naming Conventions"><![CDATA[// <Name>Static fields naming convention</Name>
// <Id>ND2001:StaticFieldsNamingConvention</Id>
// ND2001 squirix override: StyleCop SA1306 requires _camelCase; exclude intentional cells that
// would otherwise need Pascal after underscore to satisfy stock ND2001.
warnif count > 0
from f in JustMyCode.Fields
where f.IsStatic &&
     !f.IsLiteral &&
     !f.IsEnumValue &&
     !f.IsGeneratedByCompiler &&
     !f.NameLike("^_?[A-Z]") &&
     !f.NameLike("^s_") &&
     f.FullName != "Squirix.Server.Node.Observability.BackpressureMetrics._snapshotBuffer"
select new { f, Debt = 5.ToMinutes().ToDebt(), Severity = Severity.Low }]]></Query>
    </CustomRuleOverrides>
  </Queries>
</NDepend>
