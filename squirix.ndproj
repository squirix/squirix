<Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Immutable types should be tagged with [Immutable]</Name>
// <Id>ND1910:ImmutableTypesShouldBeTaggedWithImmutable</Id>
// ND1910 squirix override: report immutable types unless they are explicitly marked mutable.
warnif count > 0
from t in JustMyCode.Types
where t.IsImmutable &&
      !t.HasAttribute("Squirix.Attributes.ImmutableAttribute".AllowNoMatch()) &&
      !t.HasAttribute("Squirix.Attributes.MutableAttribute".AllowNoMatch()) &&
      !t.HasAttribute("Squirix.Attributes.ThreadSafeAttribute".AllowNoMatch()) &&
      !t.HasAttribute("Squirix.Server.Attributes.ImmutableAttribute".AllowNoMatch()) &&
      !t.HasAttribute("Squirix.Server.Attributes.MutableAttribute".AllowNoMatch()) &&
      !t.HasAttribute("Squirix.Server.Attributes.ThreadSafeAttribute".AllowNoMatch()) &&
      !t.IsGeneratedByCompiler &&
      !t.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select new { t, t.NbLinesOfCode, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>




