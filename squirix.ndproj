    <Group Name="Immutability" Active="True" ShownInReport="False">
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1900$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Avoid non-readonly static fields</Name>
// <Id>ND1901:AvoidNonReadonlyStaticFields</Id>
// ND1901 squirix override: exclude intentional process-wide mutable static cells.
warnif count > 0
from f in JustMyCode.Fields
where f.IsStatic &&
     !f.IsInitOnly &&
     !f.IsLiteral &&
     !f.IsEnumValue &&
     !f.IsGeneratedByCompiler &&
     f.FullName != "Squirix.Server.Node.Observability.BackpressureMetrics._snapshotBuffer"
select new { f, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Avoid static fields with a mutable field type</Name>
// <Id>ND1902:AvoidStaticFieldsWithAMutableFieldType</Id>
// ND1902 squirix override: stock rule uses Application.Fields and ignores notmycode.
// Explicit FullName exclusions for intentional process-wide static cells (notmycode alone is unreliable for Fields).
warnif count > 0
from f in JustMyCode.Fields
where f.IsStatic &&
     !f.IsEnumValue &&
     !f.IsGeneratedByCompiler &&
     !f.IsLiteral
let fieldType = f.FieldType
let isExcludedStaticHolder =
     f.FullNameLike("(.*\\.)?IdempotencyMetrics\\.Catalog$") ||
     f.FullNameLike("(.*\\.)?MemoryPressureMetrics\\.Catalog$") ||
     f.FullName == "Squirix.Server.Node.Observability.BackpressureMetrics.Observers" ||
     f.FullName == "Squirix.Server.Node.Observability.BackpressureMetrics.ObserversState" ||
     f.FullName == "Squirix.Server.Node.MemoryPressure.ObjectCacheEntrySizeEstimator.NullPayloadShell" ||
     f.FullName == "Squirix.Server.TestKit.MockOidcAuthority.PortPool" ||
     f.FullName == "Squirix.Server.TestKit.Mtls.ClusterTls+InternalPortPool.Allocator"
where fieldType != null &&
     !fieldType.IsThirdParty &&
     !fieldType.IsInterface &&
     !fieldType.IsDelegate &&
     !fieldType.IsImmutable &&
     !isExcludedStaticHolder
select new {
   f,
   mutableFieldType = fieldType,
   isFieldImmutable = f.IsImmutable ? "Immutable" : "Mutable",
   isFieldReadOnly = f.IsInitOnly ? "ReadOnly" : "Not ReadOnly",
   Debt = 10.ToMinutes().ToDebt(),
   Severity = Severity.Medium
}]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1903$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1914$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1904$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1905$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1906$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1907$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1908$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1909$]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1910$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND1911$]]></Query>
