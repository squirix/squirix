<Group Name="System.Threading" Active="True" ShownInReport="False">




<Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Don't create threads explicitly</Name>
// <Id>ND2500:DontCreateThreadsExplicitly</Id>
// ND2500 squirix override: durability WAL/manifest publishers own dedicated I/O threads by design
// (excluded via notmycode "Exclude durability dedicated threads from ND2500").
warnif count > 0
from m in JustMyCode.Methods
where m.CreateA("TYPE:System.Threading.Thread".AllowNoMatch())
select new { m, Debt = 30.ToMinutes().ToDebt(), Severity = Severity.High }]]></Query>




<Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2501$]]></Query>




<Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2502$]]></Query>




<Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2503$]]></Query>




<Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2504$]]></Query>




<Query Active="False" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Methods that read mutable state without synchronization</Name>
// <Id>ND2505:MethodNonSynchronizedThatReadMutableStates</Id>
// ND2505 squirix override: ignore explicitly thread-safe holder types, enum backing
// values, literals, compiler-generated fields, and analyzer details. Test and benchmark
// assemblies are already excluded from JustMyCode by the queries above.
warnif count > 0
from m in JustMyCode.Methods
where (m.ReadsMutableObjectState || m.ReadsMutableTypeState) &&
      m.ParentType != null &&
      !m.ParentType.HasAttribute("Squirix.Attributes.ThreadSafeAttribute".AllowNoMatch()) &&
      !m.ParentType.HasAttribute("Squirix.Server.Attributes.ThreadSafeAttribute".AllowNoMatch()) &&
      !m.ParentType.IsGeneratedByCompiler &&
      !m.IsUsing("System.Threading.Monitor".AllowNoMatch()) &&
      !m.IsUsing("System.Threading.ReaderWriterLock".AllowNoMatch())
let mutableFieldsUsed = m.FieldsUsed.Where(f =>
      !f.IsImmutable &&
      !f.IsEnumValue &&
      !f.IsGeneratedByCompiler &&
      !f.IsLiteral)
where mutableFieldsUsed.Any()
select new { m, mutableFieldsUsed, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>




</Group>




