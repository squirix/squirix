    </Group>
    <Group Name="Naming Conventions" Active="True" ShownInReport="False">
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2000$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Static fields naming convention</Name>
// <Id>ND2001:StaticFieldsNamingConvention</Id>
// ND2001 squirix override: StyleCop SA1306 requires _camelCase; exclude intentional cells that
// would otherwise need Pascal after underscore to satisfy stock ND2001.
warnif count > 0
from f in JustMyCode.Fields
where f.IsStatic &&
     !f.IsLiteral &&
     !f.IsEnumValue &&
     !f.IsGeneratedByCompiler &&
     !f.NameLike("^_?[A-Z]") &&
     !f.NameLike("^s_") &&
     f.FullName != "Squirix.Server.Node.Observability.BackpressureMetrics._snapshotBuffer"
select new { f, Debt = 5.ToMinutes().ToDebt(), Severity = Severity.Low }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2002$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2003$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2004$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2005$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2006$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2007$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2008$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2009$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2010$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2011$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2012$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2013$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2014$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2015$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Methods prefixed with 'Try' should return a boolean</Name>
// <Id>ND2016:MethodsPrefixedWithTryShouldReturnABoolean</Id>
// ND2016 squirix override: stock rule uses Application.Methods and ignores notmycode.
// JustMyCode excludes protobuf/gRPC generated Try* RPC stubs via notmycode queries above.
warnif count > 0
from m in JustMyCode.Methods
where m.SimpleNameLike("^Try") &&
      m.ReturnType != null &&
      m.ReturnType.FullName != "System.Boolean" &&
      !m.ReturnType.Name.Contains("Task")
select new { m, m.ReturnType, Debt = 10.ToMinutes().ToDebt(), Severity = Severity.Medium }]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2017$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2018$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2019$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2020$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2021$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2022$]]></Query>
    </Group>
    <Group Name="Source Files Organization" Active="True" ShownInReport="False">
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2100$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2101$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2102$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Namespace name should correspond to file location</Name>
// <Id>ND2103:NamespaceNameShouldCorrespondToFileLocation</Id>
// ND2103 squirix override: stock rule normalizes only '\' when matching the namespace-derived
// token against source file paths. CI runs on Linux where FilePathString uses '/', so every
// namespace looked misaligned (40 false positives). Normalize both separators; comparisons
// remain case-sensitive exactly as in the stock rule.
warnif count > 0

from a in Application.Assemblies
let assemblyName = a.Name

from n in a.ChildNamespaces
where n.SourceFileDeclAvailable
let namespaceName = n.Name

// Build the dirShouldContain string
// and then we check which source file path contains dirShouldContain or not
let dirShouldContain = (
    // namespaceName starts with assembly name => gets only components after the assembly name
    namespaceName.StartsWith(assemblyName)
    ? namespaceName.Substring(assemblyName.Length)

    // namespaceName contains assembly name => gets only components after the assembly name
    : namespaceName.Contains("." + assemblyName)
      ? namespaceName.Substring(n.Name.IndexOf("." + assemblyName))

      // namespaceName has more than one part => gets only components after the first part
      : namespaceName.Contains(".")
          ? namespaceName.Substring(n.Name.IndexOf("."))
          : namespaceName)

    // Replace dots and underscore by spaces in namespace name
    .Replace('.', ' ')
    .Replace('_', ' ')

where dirShouldContain.Length > 0

// Obtain a sourceDecl which path doesn't contain dirShouldContain
let sourceDecl = n.SourceDecls
  .OrderBy(d => d.SourceFile.FilePathString)
  .Where(d => d.SourceFile.CodeElements.All(e => JustMyCode.Contains(e)))
  .FirstOrDefault(decl =>
      // Replace dots, path separators, minus and underscores
      // by spaces in source files names
      !decl.SourceFile.FilePathString
          .Replace('.', ' ').Replace('\\', ' ').Replace('/', ' ')
          .Replace('-', ' ').Replace('_', ' ')
          .Contains(dirShouldContain)
  )
where sourceDecl != null

let dir = sourceDecl.SourceFile.FilePath.ParentDirectoryPath

let justACaseSensitiveIssue = dir.ToString()
    .Replace('.', ' ').Replace('\\', ' ').Replace('/', ' ')
    .Replace('-', ' ').Replace('_', ' ')
    .IndexOf(dirShouldContain, StringComparison.OrdinalIgnoreCase) >= 0

// Get distinct source files contained in dir through the types they contain
let typesConcerned = n.ChildTypes
    .Where(t => t.SourceFileDeclAvailable)
    .Distinct(t => t.SourceDecls.First().SourceFile.FilePathString)
    .Where(t => t.SourceDecls.First().SourceFile.FilePath.ParentDirectoryPath.Equals(dir))
    .ToArray()

select new {
   n,
   dirShouldContain,
   dir = dir.ToString(),
   justACaseSensitiveIssueStr = justACaseSensitiveIssue ? " Please note that this is solely a matter of casing." : "",
   typesConcerned,
   Debt = (justACaseSensitiveIssue ? 2 : 3).ToMinutes().ToDebt(),
   Severity = Severity.Medium
}]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2104$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2105$]]></Query>
    </Group>
    <Group Name=".NET Framework Usage" Active="True" ShownInReport="False">
      <Group Name="System" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2200$]]></Query>
        <Query Active="False" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2201$]]></Query>
        <Query Active="False" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2202$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2203$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2204$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2205$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2206$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2207$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Do not raise reserved exception types</Name>
// <Id>ND2208:DoNotRaiseReservedExceptionTypes</Id>
// ND2208 squirix override: exclude compiler-synthesized collection-expression helpers
// (<>z__ReadOnlySingleElementList<T>) whose indexer throws IndexOutOfRangeException by design.
// notmycode name filters cannot reliably remove these from JustMyCode, so filter on the
// parent type name here. All other reserved-exception creations still match.
warnif count > 0

let reservedExceptions = ThirdParty.Types.WithFullNameIn(
   "System.ExecutionEngineException",
   "System.IndexOutOfRangeException",
   "System.OutOfMemoryException",
   "System.StackOverflowException",
   "System.InvalidProgramException",
   "System.AccessViolationException",
   "System.CannotUnloadAppDomainException",
   "System.BadImageFormatException",
   "System.DataMisalignedException")

from m in JustMyCode.Methods.ThatCreateAny(reservedExceptions)
where !m.IsGeneratedByCompiler
where m.ParentType != null &&
      !m.ParentType.Name.StartsWith("<>z__")
let reservedExceptionsCreated = reservedExceptions.Where(t => m.IsUsing(t))
select new {
   m,
   reservedExceptionsCreated,
   Debt = 10.ToMinutes().ToDebt(),
   Severity = Severity.High
}]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2209$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2210$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2211$]]></Query>
      </Group>
      <Group Name="System.Collections" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2300$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2301$]]></Query>
        <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2302$]]></Query>
        <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2303$]]></Query>
      </Group>
      <Group Name="System.Runtime.InteropServices" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2400$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2401$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2402$]]></Query>
      </Group>
      <Group Name="System.Threading" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Don't create threads explicitly</Name>
// <Id>ND2500:DontCreateThreadsExplicitly</Id>
// ND2500 squirix override: durability WAL/manifest publishers own dedicated I/O threads by design
// (excluded via notmycode "Exclude durability dedicated threads from ND2500").
warnif count > 0
from m in JustMyCode.Methods
where m.CreateA("TYPE:System.Threading.Thread".AllowNoMatch())
select new { m, Debt = 30.ToMinutes().ToDebt(), Severity = Severity.High }]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2501$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2502$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2503$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="True"><![CDATA[$ND2504$]]></Query>
        <Query Active="False" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2505$]]></Query>
      </Group>
      <Group Name="System.Xml" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2600$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2601$]]></Query>
      </Group>
      <Group Name="System.Globalization" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2700$]]></Query>
      </Group>
      <Group Name="System.Reflection" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2800$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2801$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Assemblies Referenced in Multiple Versions</Name>
// <Id>ND2802:AssembliesReferencedInMultipleVersions</Id>
// ND2802 squirix override: ignore netstandard facade dual-version noise
// (Roslyn analyzers / xunit / Grpc TFMs commonly mix netstandard 2.0 vs 2.1 assembly versions).
warnif count > 0

let hashset = new HashSet<IType>()

let refs =
 (from asm in Assemblies
  from asmRef in asm.AssemblyReferences
  where !asmRef.Name.StartsWithAny("System.", "Microsoft.")
  select new {
    asm,
    RefName = asmRef.Name,
    RefVersion = asmRef.Version })
  .ToLookup(x => x.RefName)

from refsForSameAsm in refs
let variousVersions = refsForSameAsm.Distinct(x => x.RefVersion).ToArray()
where variousVersions.Length > 1 &&
      refsForSameAsm.Key != "netstandard"
let asm = Assemblies.FirstOrDefault(a => a.Name == refsForSameAsm.Key)
where asm != null
orderby asm.Name
orderby variousVersions.Length descending
let typeUsers = Application.Types.Using(asm)
    .Where(t => !t.IsGeneratedByCompiler || t.Name.StartsWith("Program+")).ToArray()
let FirstAppTypeUser = (typeUsers.Length == 0 ? Application.Types : typeUsers )
    .Aggregate((minElement, nextElement) =>
        string.Compare(nextElement.Name, minElement.Name, StringComparison.Ordinal) < 0 && !hashset.Contains(nextElement)
        ? nextElement
        : minElement)
let fillHashset = hashset.Add(FirstAppTypeUser)
select new {
  FirstAppTypeUser,
  asm,
  NbVersions = variousVersions.Length,
  Versions = variousVersions.Select(
     vv => "" + vv.asm.Name + " uses v" + vv.RefVersion.ToString() + "")
     .Aggregate("  ;  "),
  Severity = Severity.Medium,
  Debt = 15.ToMinutes().ToDebt()
}]]></Query>
      </Group>
      <Group Name="Microsoft.Contracts" Active="True" ShownInReport="False">
        <Query Active="False" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND2900$]]></Query>
      </Group>
    </Group>
    <Group Name="API Usage" Active="True" ShownInReport="False">
      <Group Name="Unity" Active="True" ShownInReport="False">
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3200$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3201$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3202$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3203$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3204$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3205$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3206$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3207$]]></Query>
        <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3208$]]></Query>
      </Group>
    </Group>
    <Group Name="Defining JustMyCode" Active="True" ShownInReport="False">
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3000$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3001$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3002$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3003$]]></Query>
      <Query Active="True" DisplayList="True" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$ND3004$]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$JustMyCode code elements$]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[$NotMyCode code elements$]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport types from JustMyCode</Name>
// Share-sourced wire types and protobuf-generated service contracts are not product-layer code.
// Removes Squirix.Transport.Grpc* from JustMyCode for all rules (including ND2016 Try* methods).
notmycode
from t in Types
where t.FullNameLike("Squirix.Transport.Grpc*")
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport methods from JustMyCode</Name>
// Explicit method discard so rules that enumerate Methods (for example ND2016) never see
// protobuf client stubs such as SquirixCacheService+SquirixCacheServiceClient.TryAddEntry.
notmycode
from m in Methods
where m.ParentType != null &&
      m.ParentType.FullNameLike("Squirix.Transport.Grpc*")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard shared gRPC transport fields from JustMyCode</Name>
notmycode
from f in Fields
where f.ParentType != null &&
      f.ParentType.FullNameLike("Squirix.Transport.Grpc*")
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source types from JustMyCode</Name>
// Exclude Roslyn/tooling *.g.cs, protobuf compiler outputs (Grpc.Tools), and common generated folders.
// Examples: obj/**/SquirixCacheGrpc.cs, obj/**/SquirixCache.cs, **/*.g.cs, **/Generated/**.
// Shared path predicate is duplicated per element kind — NDepend notmycode requires Types, Methods, and Fields separately.
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from t in Types
where t.SourceFileDeclAvailable &&
      t.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source methods from JustMyCode</Name>
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from m in Methods
where m.SourceFileDeclAvailable &&
      m.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard generated source fields from JustMyCode</Name>
notmycode
let IsGeneratedSourceFile = new Func<string, bool>(filePath =>
    filePath.ToLower().Replace('/', '\\').EndsWith(".g.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith(".pb.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcachegrpc.cs") ||
    filePath.ToLower().Replace('/', '\\').EndsWith("\\squirixcache.cs") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\obj\\") ||
    filePath.ToLower().Replace('/', '\\').Contains("\\generated\\"))
from f in Fields
where f.SourceFileDeclAvailable &&
      f.SourceDecls.Any(s => IsGeneratedSourceFile(s.SourceFile.FilePath.ToString()))
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard GeneratedCodeAttribute types from JustMyCode</Name>
notmycode
from t in Types
where t.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard GeneratedCodeAttribute methods from JustMyCode</Name>
// Grpc.Tools tags generated RPC stubs on the method (grpc_csharp_plugin), not always on the declaring type.
notmycode
from m in Methods
where m.HasAttribute("System.CodeDom.Compiler.GeneratedCodeAttribute".AllowNoMatch())
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard MutableInt holder fields from JustMyCode</Name>
// MutableInt32/MutableInt64._value is mutated via Interlocked through ref; marking it readonly is invalid C#.
notmycode
from f in Fields
where f.ParentType != null &&
      (f.ParentType.FullName == "Squirix.Server.Utils.MutableInt32" ||
       f.ParentType.FullName == "Squirix.Server.Utils.MutableInt64")
select f]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude durability dedicated threads from ND2500</Name>
// JournalCoordinator owns a long-lived WAL I/O thread by design.
// Task.Run is banned on infrastructure paths; do not refactor it to the thread pool.
// Manifest roll publishing now uses a Task (TaskCreationOptions.LongRunning) and no longer
// creates a raw Thread, so it is not excluded here.
notmycode
from m in Methods
where m.IsConstructor &&
      m.ParentType != null &&
      m.ParentType.FullName == "Squirix.Server.Storage.Journaling.JournalCoordinator"
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude ExceptionExpectation helpers from ND1208</Name>
// CA1000 / MA0018 forbid static members on generic types; instance Throws helpers are intentional.
notmycode
from m in Methods
where m.ParentType != null &&
      m.ParentType.SimpleName.EndsWith("ExceptionExpectation")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude compiler-generated collection helpers</Name>
// Collection expressions synthesize <>z__ReadOnly* types that throw reserved exception types.
notmycode
from t in Types
where t.IsGeneratedByCompiler || t.Name.StartsWith("<>z__")
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude compiler-generated collection methods</Name>
notmycode
from m in Methods
where m.ParentType != null &&
      (m.ParentType.IsGeneratedByCompiler || m.ParentType.Name.StartsWith("<>z__"))
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude CapturedMeasurement equality operators from ND1701</Name>
// Operators exist to satisfy value-type equality rules; call sites use Equals directly.
notmycode
from m in Methods
where m.IsOperator &&
      m.ParentType != null &&
      m.ParentType.Name == "CapturedMeasurement" &&
      (m.SimpleName == "op_Equality" || m.SimpleName == "op_Inequality")
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude JournalSegmentPolicy from class-to-struct suggestion</Name>
// Sealed reference type keeps Policy property semantics simple; struct conversion fights MA0008/RCS1085.
notmycode
from t in Types
where t.FullName == "Squirix.Server.Storage.Journaling.JournalSegmentPolicy"
select t]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Exclude CreateHashLocator offline tool entry</Name>
// Used by tools/sqr-ring-distribution.cs (file-based app outside analyzed assemblies).
notmycode
from m in Methods
where m.FullName == "Squirix.Server.Cluster.RuntimeServiceRegistration.CreateHashLocator(ReadOnlySpan<String>,Int32)"
select m]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard sample assemblies from JustMyCode</Name>
// Smoke/sample apps under samples/ are not product-layer code. Folder layout need not match
// RootNamespace (ND2103) and other naming rules should not gate sample harnesses.
notmycode
from a in Application.Assemblies.WithNameIn(
      "ExternalPackageSmoke")
select a]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard analyzers assembly from multi-version / cohesion noise</Name>
// Analyzers ship Roslyn packages that intentionally differ from app TFM analysis graphs.
notmycode
from a in Application.Assemblies.WithNameIn("Squirix.Analyzers")
select a]]></Query>
      <Query Active="True" DisplayList="False" DisplayStat="False" DisplaySelectionView="False" IsCriticalRule="False"><![CDATA[// <Name>Discard unit-test assemblies from cohesion / SCA gates</Name>
// Test harness cohesion and transitive SCA hits are not product-layer debt.
notmycode
from a in Application.Assemblies.WithNameIn(
      "Squirix.UnitTests",
      "Squirix.Server.UnitTests",
      "Squirix.Server.TestKit",
      "Squirix.TestKit",
      "Squirix.IntegrationTests",
      "Squirix.Server.IntegrationTests",
      "Squirix.Server.SmokeTests",
      "Squirix.E2ETests",
      "Squirix.Benchmarks",
      "Squirix.Server.Benchmarks",
      "Squirix.E2EBenchmarks")
select a]]></Query>
    </Group>
