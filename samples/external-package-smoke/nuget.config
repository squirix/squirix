<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear/>
        <add key="squirix-local" value="../../artifacts/packages"/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="squirix-local">
            <package pattern="squirix"/>
            <package pattern="squirix.server"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
