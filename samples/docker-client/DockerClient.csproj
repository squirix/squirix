<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Squirix.DockerClient</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="squirix" VersionOverride="0.1.0-preview.10" Condition="'$(ManagePackageVersionsCentrally)' == 'true'" />
    <PackageReference Include="squirix" Version="0.1.0-preview.10" Condition="'$(ManagePackageVersionsCentrally)' != 'true'" />
  </ItemGroup>
</Project>
