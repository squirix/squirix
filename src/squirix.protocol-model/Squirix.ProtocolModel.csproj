<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Squirix.ProtocolModel</RootNamespace>
        <AssemblyName>Squirix.ProtocolModel</AssemblyName>
        <StartupObject>Squirix.ProtocolModel.Program</StartupObject>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CA1515</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Squirix.ProtocolModel.Tests"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\squirix.attributes\Squirix.Attributes.csproj" />
    </ItemGroup>
</Project>
