<?xml version="1.0" encoding="utf-8"?>
<!--
  Squirix.Server namespace dependency policy (allowlist + targeted Disallowed).

  Intended layer stack (outer → inner, dependencies flow downward only):

    Adapters (REST/gRPC transport)
      → Node.Hosting (DI composition, Kestrel, options)
        → Node.Services / Node.App / Node.Bootstrap / Node.Context (runtime orchestration & decorators)
          → Cluster (routing, membership, inter-node transport)
          → LocalCache (in-memory owner cache)
          → Node.Backpressure / Node.MemoryPressure / Node.Observability / Serialization
            → Storage (journal, snapshot, manifest)
              → Kernel: Errors, Utils, Core, Contracts, Runtime.Contracts

  Shared transport CLR: Squirix.Transport.Grpc.* (compiled from shared proto/mappers).

  Child → parent is allowed implicitly. Exact parent Squirix.Server.Cluster must not depend on
  Cluster.* children (Disallowed). Composition that wires Transport/Replication lives in Node.Hosting.
  Shared peer-id filtering lives in Cluster (parent); Replication may use it via child→parent.
-->
<NsDepCopConfig IsEnabled="true"
                ChildCanDependOnParentImplicitly="true"
                CheckAssemblyDependencies="true"
                MaxIssueCount="10000">

  <!-- Assembly baseline: allow all package references except explicit cross-package violations below. -->
  <AllowedAssembly From="*" To="*" />

  <!-- Server runtime must never reference the client SDK assembly (separate package boundary). -->
  <DisallowedAssembly From="Squirix.Server" To="Squirix" />

  <!-- ═══ Allowlist (platform / packages / product) ═══ -->

  <Allowed From="*" To="System.*" />
  <Allowed From="*" To="Microsoft.*" />
  <Allowed From="*" To="JetBrains.*" />
  <Allowed From="*" To="Squirix.Attributes" />
  <Allowed From="*" To="Grpc.*" />
  <Allowed From="*" To="Google.*" />
  <Allowed From="*" To="Squirix.Transport.*" />
  <Allowed From="*" To="Squirix.Server.*" />

  <!-- ═══ Process / package boundary ═══ -->
  <!-- Server product must not depend on client SDK namespaces (only shared Squirix.Transport.Grpc is allowed). -->
  <Disallowed From="Squirix.Server.*" To="Squirix.Internal.*" />
  <Disallowed From="Squirix.Server.*" To="Squirix.Core.*" />

  <!-- ═══ Kernel purity (inner shared types must stay free of outer layers) ═══ -->

  <!-- Error contracts are domain vocabulary; must not pull orchestration types (today: CacheOperationContract → Node.Services). -->
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.Services.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.Hosting.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Cluster.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Storage.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.Backpressure.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.MemoryPressure.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.Observability.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.Node.Endpoint.*" />
  <Disallowed From="Squirix.Server.Errors.*" To="Squirix.Server.LocalCache.*" />
  <Disallowed
      From="/^Squirix\.Server\.Errors(?:\.|$)/"
      To="/^Squirix\.Server\.Runtime(?:$|\.(?!Contracts(?:\.|$)).*)$/" />

  <!-- Low-level helpers, including the relocated LogManager partials, must remain infrastructure-agnostic. -->
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Storage.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.Hosting.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Cluster.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.Services.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.Backpressure.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.MemoryPressure.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.Observability.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.Node.Endpoint.*" />
  <Disallowed From="Squirix.Server.Utils.*" To="Squirix.Server.LocalCache.*" />
  <Disallowed
      From="/^Squirix\.Server\.Utils(?:\.|$)/"
      To="/^Squirix\.Server\.Runtime(?:$|\.(?!Contracts(?:\.|$)).*)$/" />

  <!-- Runtime contracts are the inward-facing port surface. -->
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.Hosting.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Storage.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Cluster.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.LocalCache.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.Services.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.Backpressure.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.MemoryPressure.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.Observability.*" />
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="Squirix.Server.Node.Endpoint.*" />

  <!-- Contracts must not depend on the runtime implementation layer (adapters implement own port interfaces). -->
  <Disallowed From="Squirix.Server.Runtime.Contracts.*" To="/^Squirix\.Server\.Runtime(?:\.(?!Contracts(?:\.|$)).*)$/" />

  <!-- Runtime adapters implement contracts; must not become a second transport layer. -->
  <Disallowed From="Squirix.Server.Runtime.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.Runtime.*" To="Squirix.Server.Node.Hosting.*" />

  <!-- Core validators/limits are shared kernel; keep them free of node/cluster/storage orchestration. -->
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Storage.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.Hosting.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Cluster.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.Services.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.Backpressure.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.MemoryPressure.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.Observability.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.Node.Endpoint.*" />
  <Disallowed From="Squirix.Server.Core.*" To="Squirix.Server.LocalCache.*" />

  <!-- Kernel must not reach the runtime implementation layer (serialization port lives in Core.Serialization, not Runtime). -->
  <Disallowed
      From="/^Squirix\.Server\.Core(?:\.(?!Runtime\.Contracts(?:\.|$)).*)?$/"
      To="/^Squirix\.Server\.Runtime(?:$|\.(?!Contracts(?:\.|$)).*)$/" />

  <!-- ═══ Storage (durability core — must not depend upward) ═══ -->

  <!-- Persistence must not know REST/gRPC adapters. -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Adapters.*" />

  <!-- Persistence must not depend on DI composition / Kestrel wiring. -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.Hosting.*" />

  <!-- Snapshot/journal code must not depend on cluster topology types (today: SnapshotCoordinator → Cluster.Membership). -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Cluster.*" />

  <!-- Durability path must not read in-memory owner cache shapes (today: SnapshotCoordinator → LocalCache). -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.LocalCache.*" />

  <!-- Storage must not call node orchestration (today: snapshot codecs → Node.Services idempotency DTOs). -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.Services.*" />

  <!-- Storage must not emit product metrics directly (today: ManifestRetentionCleanup → Node.Observability). -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.Observability.*" />

  <!-- Storage must not depend on admission/backpressure gates. -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.Backpressure.*" />
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.MemoryPressure.*" />

  <!-- Storage must not depend on cache decorator pipeline. -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.App.*" />

  <!-- Persistence must not depend on node endpoint routing. -->
  <Disallowed From="Squirix.Server.Storage.*" To="Squirix.Server.Node.Endpoint.*" />

  <!-- ═══ Local in-memory cache ═══ -->

  <!-- Owner cache must not depend on transport adapters. -->
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Adapters.*" />

  <!-- Owner cache must not depend on cluster routing/client pool. -->
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Cluster.*" />

  <!-- Owner cache must not depend on persistence implementation (only abstractions belong above). -->
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Storage.*" />

  <!-- Owner cache must not depend on DI/host composition. -->
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.Hosting.*" />

  <!-- Entry sizing must not depend on memory-pressure gate types (today: estimators → Node.MemoryPressure). -->
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.MemoryPressure.*" />

  <!-- Owner cache must not depend on node orchestration, gates, observability, endpoint routing, or runtime. -->
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.Services.*" />
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.Backpressure.*" />
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.Observability.*" />
  <Disallowed From="Squirix.Server.LocalCache.*" To="Squirix.Server.Node.Endpoint.*" />
  <Disallowed
      From="/^Squirix\.Server\.LocalCache(?:\.|$)/"
      To="/^Squirix\.Server\.Runtime(?:$|\.(?!Contracts(?:\.|$)).*)$/" />

  <!-- ═══ Cluster (distributed routing & inter-node transport) ═══ -->

  <!-- Cluster runtime must not depend on REST/gRPC adapters. -->
  <Disallowed From="Squirix.Server.Cluster.*" To="Squirix.Server.Adapters.*" />

  <!-- Cluster registration must not reference DI composition types (today: ClusterRuntimeServiceRegistration → Node.Hosting). -->
  <Disallowed From="Squirix.Server.Cluster.*" To="Squirix.Server.Node.Hosting.*" />

  <!-- Cluster must not reference cache decorator implementations (today: ClusterRuntimeServiceRegistration → Node.App.Decorators). -->
  <Disallowed From="Squirix.Server.Cluster.*" To="Squirix.Server.Node.App.*" />

  <!-- Cluster → Storage: only Cluster.Replication → Storage.Replication is allowed (ADR Namespace DAG). -->
  <Disallowed
      From="/^Squirix\.Server\.Cluster(?:\.(?!Replication(?:\.|$)).*)?$/"
      To="/^Squirix\.Server\.Storage(?:\..*)?$/" />
  <Disallowed
      From="/^Squirix\.Server\.Cluster\.Replication(?:\..*)?$/"
      To="/^Squirix\.Server\.Storage(?:$|\.(?!Replication(?:\.|$)).*)$/" />

  <!-- ═══ Replication DAG (mirrors docs/architecture/replication-consensus.md) ═══ -->

  <!-- Exact parent must not depend on any child namespace (composition root lives in Node.Hosting). -->
  <Disallowed
      From="/^Squirix\.Server\.Cluster$/"
      To="/^Squirix\.Server\.Cluster\..+$/" />

  <!-- Parent→child restriction at depth ≥2 (root composition façade at Squirix.Server stays allowed).
       NsDepCop regex has no back-reference between From/To, so enumerate pairs explicitly.
       Only namespaces with actual children in src need rules; rest are flat leaves.
       Carve-outs baked into To patterns:
        - Storage.Journaling.Abstractions allowed (durability root composes own subsystems);
        - Storage.Journaling → Abstractions / Read / Codec allowed (JournalCoordinator composes pipeline)
        - Runtime → Runtime.Contracts allowed (adapters implement own port interfaces)
        Cluster has its own exact-parent rule above (line ~167), not duplicated here.
        Snapshot/Observability/Adapters.Grpc: parents must route through siblings, not own children. -->
   <Disallowed From="/^Squirix\.Server\.Storage$/" To="/^Squirix\.Server\.Storage\.(?!Journaling\.Abstractions(?:\.|$))[A-Za-z_][A-Za-z0-9_.]*$/" />
  <Disallowed From="/^Squirix\.Server\.Storage\.Journaling$/" To="/^Squirix\.Server\.Storage\.Journaling\.(?!Abstractions(?:\.|$)|Read(?:\.|$)|Codec(?:\.|$))[A-Za-z_][A-Za-z0-9_.]*$/" />
  <Disallowed From="/^Squirix\.Server\.Storage\.Snapshot$/" To="/^Squirix\.Server\.Storage\.Snapshot\..+$/" />
  <Disallowed From="/^Squirix\.Server\.Runtime$/" To="/^Squirix\.Server\.Runtime\.(?!Contracts(?:\.|$))[A-Za-z_][A-Za-z0-9_.]*$/" />
  <Disallowed From="/^Squirix\.Server\.Node\.App$/" To="/^Squirix\.Server\.Node\.App\..+$/" />
  <Disallowed From="/^Squirix\.Server\.Node\.Observability$/" To="/^Squirix\.Server\.Node\.Observability\..+$/" />
  <Disallowed From="/^Squirix\.Server\.Adapters\.Grpc$/" To="/^Squirix\.Server\.Adapters\.Grpc\..+$/" />

  <!-- Cluster.Replication must stay free of adapters, hosting, Node.App, and routing transport. -->
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.Adapters.*" />
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.Node.Hosting.*" />
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.Cluster.Transport.*" />
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.LocalCache.*" />
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.Errors.*" />
  <Disallowed From="Squirix.Server.Cluster.Replication.*" To="Squirix.Server.Utils.*" />
  <Disallowed
      From="/^Squirix\.Server\.Cluster\.Replication(?:\..*)?$/"
      To="/^Squirix\.Server\.Runtime(?:$|\.(?!Contracts(?:\.|$)).*)$/" />

  <!-- Storage.Replication must not depend upward on Node, Hosting, Adapters, or Cluster. -->
  <Disallowed From="/^Squirix\.Server\.Storage\.Replication(?:\..*)?$/" To="Squirix.Server.Node.*" />
  <Disallowed From="/^Squirix\.Server\.Storage\.Replication(?:\..*)?$/" To="Squirix.Server.Adapters.*" />
  <Disallowed From="/^Squirix\.Server\.Storage\.Replication(?:\..*)?$/" To="Squirix.Server.Cluster.*" />

  <!-- Endpoint / mTLS surface must not own the protocol automaton. -->
  <Disallowed From="Squirix.Server.Adapters.Endpoint.*" To="Squirix.Server.Cluster.Replication.*" />

  <!-- Node.App must not bypass Cluster.Replication into Storage.Replication. -->
  <Disallowed From="Squirix.Server.Node.App.*" To="Squirix.Server.Storage.Replication.*" />

  <!-- Product must not reference the isolated protocol-model assembly. -->
  <DisallowedAssembly From="Squirix.Server" To="Squirix.ProtocolModel" />

  <!-- ═══ Node subsystems ═══ -->

  <!-- Backpressure gate must stay independent from storage internals. -->
  <Disallowed From="Squirix.Server.Node.Backpressure.*" To="Squirix.Server.Storage.*" />

  <!-- Backpressure gate must stay free of node orchestration, hosting, endpoint routing, and transport adapters. -->
  <Disallowed From="Squirix.Server.Node.Backpressure.*" To="Squirix.Server.Node.Hosting.*" />
  <Disallowed From="Squirix.Server.Node.Backpressure.*" To="Squirix.Server.Node.Services.*" />
  <Disallowed From="Squirix.Server.Node.Backpressure.*" To="Squirix.Server.Node.App.*" />
  <Disallowed From="Squirix.Server.Node.Backpressure.*" To="Squirix.Server.Node.Endpoint.*" />
  <Disallowed From="Squirix.Server.Node.Backpressure.*" To="Squirix.Server.Adapters.*" />

  <!-- Hosted services orchestrate storage but must not depend on transport adapters. -->
  <Disallowed From="Squirix.Server.Node.Services.*" To="Squirix.Server.Adapters.*" />

  <!-- Node orchestration must not reach into storage entries internals. -->
  <Disallowed From="Squirix.Server.Node.*" To="Squirix.Server.Storage.Codecs.*" />

  <!-- Observability must stay transport-agnostic (metrics/tracing decorators live above adapters). -->
  <Disallowed From="Squirix.Server.Node.Observability.*" To="Squirix.Server.Adapters.*" />

  <!-- Cache decorator pipeline must not depend on DI option bags in Hosting (today: DeadlineCacheDecorator → CachePipelineDeadlineOptions). -->
  <Disallowed From="Squirix.Server.Node.App.*" To="Squirix.Server.Node.Hosting.*" />

  <!-- Decorators must not call transport adapters directly. -->
  <Disallowed From="Squirix.Server.Node.App.*" To="Squirix.Server.Adapters.*" />

  <!-- Decorators should not call hosted services; prefer abstractions in Runtime.Contracts / Storage.Abstractions (today: DurableMutationExecutor → Node.Services). -->
  <Disallowed From="Squirix.Server.Node.App.*" To="Squirix.Server.Node.Services.*" />

  <!-- ═══ Adapters (outer transport — should depend on contracts/runtime, not hosting/services) ═══ -->

  <!-- gRPC/REST adapters must not depend on DI composition types (today: GrpcInvocationContextInterceptor → Node.Hosting). -->
  <Disallowed From="Squirix.Server.Adapters.*" To="Squirix.Server.Node.Hosting.*" />

  <!-- Transport should call cache through Runtime/Contracts ports, not hosted services (today: SquirixServiceAdapter → Node.Services). -->
  <Disallowed From="Squirix.Server.Adapters.*" To="Squirix.Server.Node.Services.*" />

</NsDepCopConfig>
