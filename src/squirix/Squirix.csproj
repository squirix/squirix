<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <Version>$(SquirixPackageVersion)</Version>
        <PackageVersion>$(SquirixPackageVersion)</PackageVersion>
        <AssemblyName>Squirix</AssemblyName>
        <RootNamespace>Squirix</RootNamespace>
        <PackageId>squirix</PackageId>
        <Authors>Squirix Team</Authors>
        <Description>Experimental distributed cache client SDK for .NET 10. Typed ICache&lt;T&gt; API, binary TLS connectivity, custom serialization, and bootstrap failover to Squirix.Server nodes. Early preview — not production-ready.</Description>
        <RepositoryUrl>https://github.com/squirix/squirix</RepositoryUrl>
        <PackageProjectUrl>https://github.com/squirix/squirix</PackageProjectUrl>
        <PackageTags>dotnet;cache;distributed-cache;csharp;tls;key-value-store;client</PackageTags>
        <PackageReleaseNotes>Squirix 0.2.0-preview.1 uses the native server and updates the client packages. See https://github.com/squirix/squirix/blob/main/docs/release-notes/v0.2.0-preview.1.md</PackageReleaseNotes>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <TargetFramework Condition="'$(SquirixPackAllFrameworks)' != 'true'">$(SquirixTargetFramework)</TargetFramework>
        <TargetFrameworks Condition="'$(SquirixPackAllFrameworks)' == 'true'">net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="All"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\shared\Squirix\Transport\Wire\CacheMessages.g.cs" Link="Transport\Wire\CacheMessages.g.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\CacheWritePayload.cs" Link="Transport\Wire\CacheWritePayload.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\GetDistributedAsyncResponse.cs" Link="Transport\Wire\GetDistributedAsyncResponse.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\GetValueAsyncResponse.cs" Link="Transport\Wire\GetValueAsyncResponse.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\BinaryTracedRequest.cs" Link="Transport\Wire\BinaryTracedRequest.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireMessage.cs" Link="Transport\Wire\Codec\WireMessage.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\IWireBody.cs" Link="Transport\Wire\Codec\IWireBody.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireTraceParent.cs" Link="Transport\Wire\Codec\WireTraceParent.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireDecoder.cs" Link="Transport\Wire\Codec\WireDecoder.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\IWireParser.cs" Link="Transport\Wire\Codec\IWireParser.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireParser.cs" Link="Transport\Wire\Codec\WireParser.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireBodyParser.cs" Link="Transport\Wire\Codec\WireBodyParser.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireReader.cs" Link="Transport\Wire\Codec\WireReader.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireNameCache.cs" Link="Transport\Wire\Codec\WireNameCache.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireByteRange.cs" Link="Transport\Wire\Codec\WireByteRange.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireWriter.cs" Link="Transport\Wire\Codec\WireWriter.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\Codec\WireSegments.cs" Link="Transport\Wire\Codec\WireSegments.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Binary\Frames.cs" Link="Transport\Binary\Frames.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Binary\FrameStatus.cs" Link="Transport\Binary\FrameStatus.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\ConnectionAuthenticationProtocol.cs" Link="Internal\Cluster\Transport\Wire\ConnectionAuthenticationProtocol.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\shared\Squirix\Transport\Wire\RpcAttemptTimeout.cs" Link="Internal\Cluster\Transport\Wire\RpcAttemptTimeout.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\RpcOperationIdentity.cs" Link="Internal\Cluster\Transport\Wire\RpcOperationIdentity.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\TimedCancellation.cs" Link="Internal\Cluster\Transport\Wire\TimedCancellation.cs"/>
        <Compile Include="..\shared\Squirix\Transport\Wire\CacheValueWire.cs" Link="Internal\Cluster\Transport\Wire\CacheValueWire.cs"/>
        <None Include="..\..\README.md" Pack="true" PackagePath="/"/>
        <None Include="icon.png" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\squirix.attributes\SquirixAttribute.cs" Link="Attributes\SquirixAttribute.cs"/>
        <Compile Include="..\squirix.attributes\ImmutableAttribute.cs" Link="Attributes\ImmutableAttribute.cs"/>
    </ItemGroup>
</Project>
