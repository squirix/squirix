<?xml version="1.0" encoding="utf-8"?>
<!--
  Squirix client SDK namespace dependency policy.

  Intended layer stack (outer → inner):

    Squirix (public API: ISquirixClient, ICache, exceptions)
      → Squirix.Core (public helpers)
      → Squirix.Internal (remote cache, session factory)
        → Squirix.Internal.Cluster (gRPC client pool, call policy, bootstrap failover)
      → Squirix.Transport.Grpc.* (shared generated transport CLR)

  Public sub-namespace Core must remain usable without importing Internal.*.
  SquirixClient in root namespace Squirix is the deliberate façade that may
  construct Internal implementations.
-->
<NsDepCopConfig IsEnabled="true"
                ChildCanDependOnParentImplicitly="true"
                CheckAssemblyDependencies="true">

  <Allowed From="*" To="*" />

  <AllowedAssembly From="*" To="*" />

  <!-- Client SDK must never reference the server package/assembly. -->
  <DisallowedAssembly From="Squirix" To="Squirix.Server" />

  <!-- Client SDK must never reference the isolated protocol-model assembly. -->
  <DisallowedAssembly From="Squirix" To="Squirix.ProtocolModel" />

  <!-- ═══ Package boundary ═══ -->

  <!-- Client code must not depend on server runtime namespaces (shared transport is Squirix.Transport.Grpc only). -->
  <Disallowed From="Squirix.*" To="Squirix.Server.*" />
  <Disallowed From="Squirix.Transport.*" To="Squirix.Server.*" />
  <Disallowed From="Squirix.*" To="Squirix.ProtocolModel.*" />
  <Disallowed From="Squirix.Transport.*" To="Squirix.ProtocolModel.*" />

  <!-- ═══ Public surface purity ═══ -->

  <!-- Cache name/key validators are public helpers; must not pull remote implementation. -->
  <Disallowed From="Squirix.Core.*" To="Squirix.Internal.*" />

  <!-- Public helpers must not depend on the public client façade. -->
  <Disallowed From="/^Squirix\.Core(?:\.|$)/" To="/^Squirix$/" />
  <Disallowed From="/^Squirix\.Core(?:\.|$)/" To="/^Squirix\.Client(?:\.|$)/" />

  <!-- ═══ Internal layering ═══ -->

  <!-- Cluster internals must not reach the public surface, public helpers, or the remote session factory. -->
  <Disallowed From="/^Squirix\.Internal\.Cluster(?:\.|$).*$/" To="/^Squirix$/" />
  <Disallowed From="/^Squirix\.Internal\.Cluster(?:\.|$).*$/" To="/^Squirix\.Client(?:\.|$)/" />
  <Disallowed From="/^Squirix\.Internal\.Cluster(?:\.|$).*$/" To="/^Squirix\.Core(?:\.|$)/" />
  <Disallowed From="/^Squirix\.Internal\.Cluster(?:\.|$).*$/" To="/^Squirix\.Internal$/" />

</NsDepCopConfig>
