<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework Condition="'$(SquirixPackAllFrameworks)' != 'true'">$(SquirixTargetFramework)</TargetFramework>
        <TargetFrameworks Condition="'$(SquirixPackAllFrameworks)' == 'true'">net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Version>$(SquirixPackageVersion)</Version>
        <PackageVersion>$(SquirixPackageVersion)</PackageVersion>
        <AssemblyName>Squirix.Server.Host</AssemblyName>
        <RootNamespace>Squirix.Server.Host</RootNamespace>
        <PackageId>squirix.server.tool</PackageId>
        <Description>Standalone squirix-server CLI and process host for local evaluation and deployment of Squirix.Server nodes. Early preview.</Description>
        <Authors>Squirix Team</Authors>
        <RepositoryUrl>https://github.com/squirix/squirix</RepositoryUrl>
        <PackageProjectUrl>https://github.com/squirix/squirix</PackageProjectUrl>
        <PackageTags>dotnet;cache;distributed-cache;tool;cli;server</PackageTags>
        <PackageReleaseNotes>Squirix 0.1.0 first public preview. See https://github.com/squirix/squirix/blob/main/docs/release-notes/v0.1.0.md</PackageReleaseNotes>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <IsPackable>true</IsPackable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>squirix-server</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\squirix.server\Squirix.Server.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
        <None Include="icon.png" Pack="true" PackagePath="/"/>
        <None Include="Squirix.settings.default.json" CopyToOutputDirectory="PreserveNewest"/>
        <None Include="appsettings.defaults.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\squirix.server\Attributes\SquirixAttribute.cs" Link="Attributes\SquirixAttribute.cs"/>
        <Compile Include="..\squirix.server\Attributes\ImmutableAttribute.cs" Link="Attributes\ImmutableAttribute.cs"/>
    </ItemGroup>

    <Target Name="GenerateHostBuildMetadata" BeforeTargets="BeforeCompile;CoreCompile">
        <PropertyGroup>
            <HostBuildMetadataFile>$(IntermediateOutputPath)BuildMetadata.g.cs</HostBuildMetadataFile>
            <HostBuildMetadataSource>// &lt;auto-generated /&gt;
namespace Squirix.Server.Host%3B

internal static class BuildMetadata
{
    internal const string InformationalVersion = "$(PackageVersion)"%3B
}
            </HostBuildMetadataSource>
        </PropertyGroup>
        <WriteLinesToFile File="$(HostBuildMetadataFile)" Lines="$(HostBuildMetadataSource)"
                          Overwrite="true" WriteOnlyWhenDifferent="true"/>
        <ItemGroup>
            <Compile Include="$(HostBuildMetadataFile)"/>
            <FileWrites Include="$(HostBuildMetadataFile)"/>
        </ItemGroup>
    </Target>
</Project>
