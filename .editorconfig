# Top-most EditorConfig file
root = true

# Global settings
[*.{cs,csproj,props,targets,sln,json,md,yml,yaml,editorconfig,xml,txt,proto,ps1,runsettings,config,toml,http,svg,cshtml,razor,sql,sh,cmd,bat,mdc,csx}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 180

# Use latest C# style rules
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_new_line_before_open_brace = all
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_place_expr_method_on_single_line = if_owner_is_single_line
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_namespace_declarations = file_scoped
csharp_prefer_static_local_function = true:error
csharp_prefer_braces = when_multiline:error
csharp_style_deconstructed_variable_declaration = true:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_local_functions = false:warning
# Prefer explicit discard when intentionally ignoring a value
csharp_style_unused_value_expression_statement_preference = discard_variable:warning
csharp_style_unused_value_assignment_preference = discard_variable:warning
# Nullable and language are enforced via MSBuild too
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
csharp_space_after_cast = false

# Elevate reliability/security/performance rules
# Resource leaks and disposal
# Dispose objects before losing scope
dotnet_diagnostic.CA2000.severity = error
# Disposable fields should be disposed
dotnet_diagnostic.CA2213.severity = error
# Use ValueTask correctly
dotnet_diagnostic.CA2012.severity = error
# Dispose methods should call base
dotnet_diagnostic.CA1816.severity = error

# Code readability (StyleCop)
# Each attribute on its own line
dotnet_diagnostic.SA1134.severity = error
# Do not use regions
dotnet_diagnostic.SA1124.severity = error
# Disable SA1503 for single-line child statements
dotnet_diagnostic.SA1503.severity = none
# Require braces for multi-line statements
dotnet_diagnostic.SA1519.severity = warning
# Prefix with this - disabled
dotnet_diagnostic.SA1101.severity = none
# Allow leading underscore fields
dotnet_diagnostic.SA1309.severity = none
# Using directives placement
dotnet_diagnostic.SA1200.severity = none
# Missing XML comment for publicly visible type or member
dotnet_diagnostic.SA1600.severity = none
# No block-scoped namespace preference
dotnet_diagnostic.IDE0160.severity = none
# Use file-scoped namespaces
dotnet_diagnostic.IDE0161.severity = error
# Use primary constructor
dotnet_diagnostic.IDE0290.severity = none
# Enforce formatting, including single-line expression members when they fit the line width
dotnet_diagnostic.IDE0055.severity = error

# SonarAnalyzer
# Loops should be simplified with LINQ - intentionally disabled; this codebase prefers explicit loops.
dotnet_diagnostic.S3267.severity = none
# Method overloads should be grouped together - conflicts with Rider/ReSharper file layout for object overrides.
dotnet_diagnostic.S4136.severity = none
# Prefer string.Create / FormattableString over alternatives - conflicts with BannedSymbols.txt string formatting policy.
dotnet_diagnostic.S6618.severity = none

# Performance
# Mark members as static
dotnet_diagnostic.CA1822.severity = error
# Use Span-based string append
dotnet_diagnostic.CA1834.severity = error
# Use SearchValues for char search
dotnet_diagnostic.CA1861.severity = error
# Unused private fields
dotnet_diagnostic.CA1823.severity = warning
# Avoid unnecessary zero-length array allocations
dotnet_diagnostic.CA1825.severity = warning
# Use span-based overloads
dotnet_diagnostic.CA1845.severity = warning
# Seal types for performance
dotnet_diagnostic.CA1852.severity = warning
# Cache and reuse Regex
dotnet_diagnostic.CA1869.severity = warning

# Exceptions/Usage correctness
# Do not raise reserved exception types
dotnet_diagnostic.CA2201.severity = warning
# Instantiate argument exceptions correctly
dotnet_diagnostic.CA2208.severity = warning

# Banned API symbols (BannedSymbols.txt)
# ECMA documentation IDs with full parameter lists are required; partial names are ignored silently.
# exclude_generated_code is in .globalconfig (EditorConfig does not apply to in-memory source generators).
# Symbol has been banned
dotnet_diagnostic.RS0030.severity = error
# Symbol has been banned for use in declarations
dotnet_diagnostic.RS0031.severity = error
# Implicit culture ToString in interpolation - project standard is $"" instead of string.Format / FormattableString.
dotnet_diagnostic.MA0076.severity = none

# Async/Cancellation correctness
# Forward CancellationToken
dotnet_diagnostic.CA2016.severity = warning

# Spacing/ordering guidelines
# Elements ordering
dotnet_diagnostic.SA1201.severity = warning

# Reduce noise from commonly noisy rules
# File header
dotnet_diagnostic.SA1633.severity = none

# Enforce member ordering by access so private members come after public/internal/protected
# Elements should be ordered by access
dotnet_diagnostic.SA1202.severity = error

# Rider/ReSharper inspections
resharper_redundant_empty_switch_section_highlighting = none
resharper_xmldoc_indent_text = zero_indent
resharper_arguments_string_literal = positional
resharper_arguments_other = positional
resharper_arguments_literal = positional
resharper_arguments_style_other_highlighting = suggestion
resharper_arguments_style_string_literal_highlighting = suggestion
resharper_arguments_style_literal_highlighting = suggestion
resharper_enforce_if_statement_braces_highlighting = warning
resharper_convert_to_primary_constructor_highlighting = none
resharper_braces_for_ifelse = not_required_for_both
resharper_braces_redundant = false
resharper_loop_can_be_converted_to_query_highlighting = none
resharper_loop_can_be_partly_converted_to_query_highlighting = none
resharper_foreach_can_be_converted_to_query_using_another_get_enumerator_highlighting = none
resharper_foreach_can_be_partly_converted_to_query_using_another_get_enumerator_highlighting = none
resharper_arrange_redundant_parentheses_highlighting = none
resharper_for_can_be_converted_to_foreach_highlighting = none
resharper_convert_if_statement_to_return_statement_highlighting = none
resharper_convert_if_statement_to_switch_statement_highlighting = none
# Allocation-free delegates: static keyword (general), and captures on [RequireStaticDelegate] parameters.
# Rider hint "Closure can be eliminated: method has overload..." has no editorconfig key — use the TState overload instead.
resharper_lambda_expression_can_be_made_static_highlighting = error
resharper_lambda_expression_must_be_static_highlighting = error
resharper_lambda_should_not_capture_context_highlighting = error
resharper_redundant_suppress_nullable_warning_expression_highlighting = warning
resharper_switch_statement_missing_some_enum_cases_no_default_highlighting = warning
resharper_switch_statement_handles_some_known_enum_values_with_default_highlighting = warning

# Visual Studio keys (Rider understands them too)
csharp_indent_switch_labels = true
csharp_indent_case_contents = true
csharp_indent_case_contents_when_block = false

# Rider/ReSharper C# formatting
[*.cs]

# Roslynator (RCS): all rules at warning+ so they appear in dotnet build (TreatWarningsAsErrors => error).
dotnet_analyzer_diagnostic.category-roslynator.severity = warning
# Remove unnecessary case label — conflicts with exhaustive switch style in this codebase.
dotnet_diagnostic.RCS1069.severity = none
# Convert interpolated string to concatenation
dotnet_diagnostic.RCS1217.severity = none
# Remove redundant statement — conflicts with explicit control-flow in some methods.
dotnet_diagnostic.RCS1134.severity = none
# RCS1021: Use expression-bodied lambda, it makes XUnit box the value inside an assert
dotnet_diagnostic.RCS1021.severity = none


# ZeroAlloc.Analyzers (ZA): promote Info rules to warning for dotnet build (TreatWarningsAsErrors => error).
# No single category-zeroalloc — rules use Performance.* subcategories (see ZeroAlloc DiagnosticCategories.cs).
# Do NOT use category-Performance: that also elevates CA18xx/CA186x NetAnalyzers in the same bucket.
dotnet_analyzer_diagnostic.category-Performance.Collections.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Strings.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Memory.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Logging.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Boxing.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Linq.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Regex.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Enums.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Sealing.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Serialization.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Async.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Delegates.severity = warning
dotnet_analyzer_diagnostic.category-Performance.ValueTypes.severity = warning
dotnet_analyzer_diagnostic.category-Performance.DataLayout.severity = warning
dotnet_analyzer_diagnostic.category-Performance.Aot.severity = warning

# ErrorProne.NET (EPC/ERP/EPS): all rules at warning for dotnet build (TreatWarningsAsErrors => error).
# Docs: https://github.com/SergeyTeplyakov/ErrorProne.NET/tree/master/docs/Rules
# Per-rule IDs avoid category-Performance bulk config (collides with CA18xx/CA186x and ZeroAlloc Performance.*).
dotnet_diagnostic.EPC11.severity = warning
dotnet_diagnostic.EPC12.severity = warning
dotnet_diagnostic.EPC13.severity = warning
dotnet_diagnostic.EPC14.severity = warning
dotnet_diagnostic.EPC15.severity = warning
dotnet_diagnostic.EPC16.severity = warning
dotnet_diagnostic.EPC17.severity = warning
dotnet_diagnostic.EPC18.severity = warning
dotnet_diagnostic.EPC19.severity = warning
dotnet_diagnostic.EPC20.severity = warning
dotnet_diagnostic.EPC23.severity = warning
dotnet_diagnostic.EPC24.severity = warning
dotnet_diagnostic.EPC25.severity = warning
dotnet_diagnostic.EPC26.severity = warning
dotnet_diagnostic.EPC27.severity = warning
dotnet_diagnostic.EPC28.severity = warning
dotnet_diagnostic.EPC29.severity = warning
dotnet_diagnostic.EPC30.severity = warning
dotnet_diagnostic.EPC31.severity = warning
dotnet_diagnostic.EPC32.severity = warning
dotnet_diagnostic.EPC33.severity = warning
dotnet_diagnostic.EPC34.severity = warning
dotnet_diagnostic.EPC35.severity = warning
dotnet_diagnostic.EPC36.severity = warning
dotnet_diagnostic.EPC37.severity = warning
dotnet_diagnostic.EPC38.severity = warning
dotnet_diagnostic.EPC39.severity = warning
dotnet_diagnostic.EPC40.severity = warning
dotnet_diagnostic.EPC41.severity = warning
dotnet_diagnostic.ERP021.severity = warning
dotnet_diagnostic.ERP022.severity = warning
dotnet_diagnostic.ERP031.severity = warning
dotnet_diagnostic.ERP041.severity = warning
dotnet_diagnostic.ERP042.severity = warning
dotnet_diagnostic.EPS01.severity = warning
dotnet_diagnostic.EPS05.severity = warning
dotnet_diagnostic.EPS06.severity = warning
dotnet_diagnostic.EPS09.severity = warning
dotnet_diagnostic.EPS10.severity = warning
dotnet_diagnostic.EPS11.severity = warning
dotnet_diagnostic.EPS12.severity = warning
dotnet_diagnostic.EPS13.severity = warning

# General line break behavior
resharper_csharp_keep_existing_linebreaks = false
resharper_keep_existing_linebreaks = false
resharper_keep_existing_expr_member_arrangement = false

# Expression-bodied members
resharper_csharp_place_expr_method_on_single_line = always

# Braces and embedded statements
resharper_csharp_new_line_before_while = true
resharper_csharp_place_simple_embedded_statement_on_same_line = never

# Attributes
# Keep attributes on separate lines. Full cleanup must not merge [ThreadStatic] onto the field; SA1134.
csharp_place_field_attribute_on_same_line = false
csharp_place_attribute_on_same_line = false
resharper_csharp_place_field_attribute_on_same_line = false
resharper_csharp_place_attribute_on_same_line = false
resharper_csharp_keep_existing_attribute_arrangement = false

# Method calls / arguments
resharper_csharp_wrap_arguments_style = wrap_if_long
resharper_csharp_wrap_parameters_style = wrap_if_long
resharper_csharp_wrap_after_invocation_lpar = false
resharper_csharp_wrap_before_invocation_rpar = false
resharper_csharp_wrap_after_declaration_lpar = false
resharper_csharp_wrap_before_declaration_rpar = false

# Chained method calls
resharper_csharp_wrap_chained_method_calls = wrap_if_long
resharper_csharp_wrap_before_first_method_call = false

# Object / collection / array initializers
resharper_csharp_wrap_object_and_collection_initializer_style = wrap_if_long
resharper_csharp_wrap_array_initializer_style = wrap_if_long

# LINQ / query-like wrapping
resharper_csharp_wrap_linq_expressions = wrap_if_long
resharper_csharp_wrap_before_linq_expression = false

# Binary / conditional expressions
resharper_csharp_wrap_ternary_expr_style = wrap_if_long

# Lambda / anonymous methods
resharper_csharp_wrap_before_arrow_with_expressions = false

# Base list / generic constraints
resharper_csharp_wrap_extends_list_style = wrap_if_long
resharper_csharp_wrap_multiple_type_parameter_constraints_style = chop_always
resharper_csharp_place_type_constraints_on_same_line = false

# Constructor initializers
# Keep StyleCop SA1128-compatible formatting.
resharper_csharp_place_constructor_initializer_on_same_line = false
resharper_place_constructor_initializer_on_same_line = false

# Meziantou.Analyzer Rules
# Allow member access expressions (e.g. request.Definition) where the root is a parameter.
MA0015.consider_member_access_as_parameter = true

# MA0016: Prefer collection abstraction over concrete types on public API — conflicts with zero-allocation and concrete test helpers.
dotnet_diagnostic.MA0016.severity = none
# MA0003: Require named arguments when passing literal values to method calls.
dotnet_diagnostic.MA0003.severity = none
# MA0157: Methods returning IAsyncEnumerable must not use the Async suffix.
dotnet_diagnostic.MA0157.severity = none
# MA0038: Make instance method static (deprecated; prefer CA1822).
dotnet_diagnostic.MA0038.severity = none
# MA0111: Prefer string.Create over FormattableString - conflicts with BannedSymbols.txt string formatting policy.
dotnet_diagnostic.MA0111.severity = none
# MA0174: Record declarations should use explicit 'record class' keyword.
dotnet_diagnostic.MA0174.severity = none
# MA0192: Use HasFlag instead of bitwise checks; it adds extra allocations
dotnet_diagnostic.MA0192.severity = none
# MA0211: Require multi-line <summary> XML comments; single-line summaries are fine for short, obvious members.
dotnet_diagnostic.MA0211.severity = none

[tools/**]
# MA0047: Types must be declared inside a namespace (file-based scripts use top-level statements).
dotnet_diagnostic.MA0047.severity = none
# MA0048: File name must match the primary type name (script file names differ from inline types).
dotnet_diagnostic.MA0048.severity = none
# MA0051: Method exceeds configured line/statement limits (verify/pack scripts are intentionally long).
dotnet_diagnostic.MA0051.severity = none
# RCS1110: Declare type inside namespace (inline helper types in file-based scripts).
dotnet_diagnostic.RCS1110.severity = none
# ZA0901: Seal class for JIT devirtualization (implicit Program from top-level statements cannot be sealed).
dotnet_diagnostic.ZA0901.severity = none

[examples/**]
# MA0048: File name must match the primary type name (script file names differ from inline types).
dotnet_diagnostic.MA0048.severity = none
# ZA0901: Seal class for JIT devirtualization (implicit Program from top-level statements cannot be sealed).
dotnet_diagnostic.ZA0901.severity = none

[{tests,benchmarks}/**]
# SA1615: Element return value should be documented (async tests/benchmarks return Task; boilerplate <returns> is redundant).
# Other paths (for example src/**) keep the default SA1615 severity when a member is already documented.
dotnet_diagnostic.SA1615.severity = none

[tests/**]
# xUnit.net: dotnet build prints warning+ only. Info/Hidden rules stay silent until elevated.
# These fire only on violations — clean tests => 0 xUnit lines in build output.
dotnet_diagnostic.xUnit1030.severity = error
dotnet_diagnostic.xUnit1031.severity = error
dotnet_diagnostic.xUnit1049.severity = error
dotnet_diagnostic.xUnit1051.severity = error
dotnet_diagnostic.xUnit2000.severity = error
dotnet_diagnostic.xUnit2002.severity = error
dotnet_diagnostic.xUnit2003.severity = error
dotnet_diagnostic.xUnit2004.severity = error
dotnet_diagnostic.xUnit2006.severity = error
dotnet_diagnostic.xUnit2012.severity = error
dotnet_diagnostic.xUnit2017.severity = error
dotnet_diagnostic.xUnit2021.severity = error

[benchmarks/**]
# BenchmarkDotNet rules (BDN1xxx) default to error; keep explicit for discoverability in editorconfig.
dotnet_diagnostic.BDN1400.severity = error
dotnet_diagnostic.BDN1500.severity = error

[**/*Grpc.cs]
dotnet_diagnostic.SA1518.severity = none

[**/XunitAutoGeneratedEntryPoint.cs]
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.RS0031.severity = none

[**/*.g.cs]
# Source generators (System.Text.Json, gRPC, etc.) may call banned APIs such as String.Format.
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.RS0031.severity = none
# Generated sources often use bare [ExcludeFromCodeCoverage] without justification.
dotnet_diagnostic.EPC29.severity = none

[**/obj/**]
# MSBuild intermediate output (source generators, gRPC, JSON context, etc.).
dotnet_diagnostic.RS0030.severity = none
dotnet_diagnostic.RS0031.severity = none
dotnet_diagnostic.EPC29.severity = none

# Analyzer execution settings
# Enable concurrent execution and generated code handling are set via MSBuild props
