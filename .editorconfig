# Top-most EditorConfig file
root = true # top-most EditorConfig; stops parent-dir lookup

# ===========================================================================
# Core file settings (apply to every tracked file)
# ===========================================================================
[*.{cs,csproj,props,targets,sln,json,md,yml,yaml,editorconfig,xml,txt,proto,ps1,runsettings,config,toml,http,svg,cshtml,razor,sql,sh,cmd,bat,mdc,csx}]
charset = utf-8 # file encoding
end_of_line = lf # normalize line endings to LF
indent_size = 4 # indent width in spaces
indent_style = space # use spaces, not tabs
insert_final_newline = true # ensure trailing newline at EOF
max_line_length = 180 # hard limit for line length
tab_width = 4 # visual tab width
trim_trailing_whitespace = true # strip trailing whitespace

# ===========================================================================
# C# language style + IDE code-style diagnostics
# ===========================================================================
csharp_new_line_before_open_brace = all # place open brace on its own line (Allman)
csharp_place_expr_method_on_single_line = if_owner_is_single_line # keep expression-bodied method on one line only if owner fits
csharp_prefer_braces = false # omit braces for single embedded statements (incl nested loops); keep for multi-statement bodies (SQR0008). when_multiline/SA1519/RCS1001 would force braces
csharp_prefer_simple_using_statement = true:warning # prefer using declaration over using block
csharp_prefer_static_local_function = true:error # prefer static local functions
csharp_space_after_cast = false # no space after a cast
csharp_style_deconstructed_variable_declaration = true:warning # prefer deconstructed variable declaration
csharp_style_expression_bodied_accessors = when_on_single_line:warning # expression body for accessors when single line
csharp_style_expression_bodied_indexers = when_on_single_line:warning # expression body for indexers when single line
csharp_style_expression_bodied_local_functions = false:warning # no expression body for local functions
csharp_style_expression_bodied_methods = when_on_single_line:warning # expression body for methods when single line
csharp_style_expression_bodied_operators = false:warning # no expression body for operators
csharp_style_expression_bodied_properties = when_on_single_line:warning # expression body for properties when single line
csharp_style_inlined_variable_declaration = true:warning # prefer inlined variable declaration
csharp_style_namespace_declarations = file_scoped # use file-scoped namespaces
csharp_style_pattern_matching_over_as_with_null_check = true:warning # pattern match over as plus null check
csharp_style_pattern_matching_over_is_with_cast_check = true:warning # pattern match over is plus cast check
csharp_style_prefer_not_pattern = true:warning # prefer not pattern
csharp_style_prefer_pattern_matching = true:warning # prefer pattern matching
csharp_style_prefer_switch_expression = true:warning # prefer switch expression
csharp_style_unused_value_assignment_preference = discard_variable:warning # prefer discard for unused assignments
csharp_style_unused_value_expression_statement_preference = discard_variable:warning # prefer explicit discard when intentionally ignoring a value
csharp_style_var_elsewhere = true:suggestion # use var where type not apparent
csharp_style_var_for_built_in_types = true:warning # prefer var for built-in types
csharp_style_var_when_type_is_apparent = true:suggestion # use var when type apparent

dotnet_diagnostic.CA1510.severity = warning # throw helpers instead of multi-line ArgumentNullException/ObjectDisposedException blocks
dotnet_diagnostic.CA1511.severity = warning # use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = warning # use InvalidOperationException throw helper
dotnet_diagnostic.CA1513.severity = warning # use ObjectDisposedException throw helper
dotnet_diagnostic.IDE0003.severity = warning # suppresses redundant this. qualification
dotnet_diagnostic.IDE0005.severity = error # remove unused using directives (fails build via EnforceCodeStyleInBuild)
dotnet_diagnostic.IDE0007.severity = warning # use implicit type (var) where applicable
dotnet_diagnostic.IDE0011.severity = error # IDE0011 unreliable at omitting braces when csharp_prefer_braces=false; SQR0010 is the build gate for single-line bodies
dotnet_diagnostic.IDE0017.severity = warning # use object initializers
dotnet_diagnostic.IDE0018.severity = warning # use inlined variable declaration
dotnet_diagnostic.IDE0019.severity = warning # pattern match over as with null check
dotnet_diagnostic.IDE0020.severity = warning # pattern match over is with cast check
dotnet_diagnostic.IDE0021.severity = warning # use expression body for constructors
dotnet_diagnostic.IDE0022.severity = warning # use expression body for methods
dotnet_diagnostic.IDE0023.severity = warning # use expression body for conversion operators
dotnet_diagnostic.IDE0025.severity = warning # use expression body for properties
dotnet_diagnostic.IDE0026.severity = warning # use expression body for indexers
dotnet_diagnostic.IDE0027.severity = warning # use expression body for accessors
dotnet_diagnostic.IDE0028.severity = warning # use collection initializers
dotnet_diagnostic.IDE0029.severity = warning # simplify null check with coalesce expression
dotnet_diagnostic.IDE0031.severity = warning # use null propagation (?.)
dotnet_diagnostic.IDE0041.severity = warning # use is null / is not null check
dotnet_diagnostic.IDE0045.severity = none # do not convert if statement to switch statement
dotnet_diagnostic.IDE0055.severity = error # enforce code-style formatting in build
dotnet_diagnostic.IDE0063.severity = warning # use simple using statement
dotnet_diagnostic.IDE0066.severity = warning # use switch expression
dotnet_diagnostic.IDE0074.severity = warning # use coalesce compound assignment
dotnet_diagnostic.IDE0078.severity = none # use pattern matching combinators (and/or)
dotnet_diagnostic.IDE0083.severity = warning # use not pattern
dotnet_diagnostic.IDE0090.severity = warning # use target-typed new (simplify new expression)
dotnet_diagnostic.IDE0130.severity = error # namespace should match folder
dotnet_diagnostic.IDE0160.severity = none # no block-scoped namespace preference
dotnet_diagnostic.IDE0161.severity = error # use file-scoped namespaces
dotnet_diagnostic.IDE0290.severity = none # use primary constructor
dotnet_diagnostic.IDE0300.severity = warning # use collection expression for array
dotnet_diagnostic.IDE0301.severity = warning # use collection expression for empty
dotnet_diagnostic.IDE0305.severity = warning # use collection expression for fluent

dotnet_style_collection_initializer = true:warning # use collection initializer
dotnet_style_coalesce_expression = true:warning # use coalesce expression
dotnet_style_null_propagation = true:warning # use null propagation
dotnet_style_object_initializer = true:warning # use object initializer
dotnet_style_prefer_collection_expression = when_types_exactly_match:warning # use collection expression when types match
dotnet_style_prefer_compound_assignment = true:warning # use compound assignment
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning # use is null check over reference equality
dotnet_style_qualification_for_event = false:warning # do not qualify events with this.
dotnet_style_qualification_for_field = false:warning # omit redundant this. (IDE0003 warning fails build under TreatWarningsAsErrors); SA1101 stays none
dotnet_style_qualification_for_method = false:warning # do not qualify methods with this.
dotnet_style_qualification_for_property = false:warning # do not qualify properties with this.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion # nullable/language enforced via MSBuild too

resharper_arrange_this_qualifier_highlighting = error # legacy alias of arrange_this_qualifier (Rider deprecates redundant_this_qualifier)
resharper_instance_members_qualify_members = none # do not require this. qualification (Rider)

# ===========================================================================
# Argument style (positional vs named)
# ===========================================================================
# Prefer positional args; in-order named arguments fail the build.
resharper_arguments_literal = positional # Rider: positional args for literals
resharper_arguments_other = positional # Rider: positional args for other
resharper_arguments_string_literal = positional # Rider: positional args for string literals
resharper_arguments_style_anonymous_function_highlighting = error # flag anonymous-function arg style
resharper_arguments_style_literal_highlighting = error # flag literal arg style
resharper_arguments_style_named_expression_highlighting = error # flag named-expression arg style
resharper_arguments_style_other_highlighting = error # flag other arg style
resharper_arguments_style_string_literal_highlighting = error # flag string-literal arg style
resharper_redundant_argument_default_value_highlighting = warning # parameter has same default value as another (Rider UI + SQR011 build gate)

# ===========================================================================
# Squirix analyzers (SQR*)
# ===========================================================================
dotnet_diagnostic.SQR0001.severity = error # outer for/foreach/while/do must omit braces when body is only a nested loop
dotnet_diagnostic.SQR0002.severity = error # cap methods per type (threshold via SQR0002.max_methods_per_type, default 20)
dotnet_diagnostic.SQR0003.severity = error # cap fields per type (threshold via SQR0003.max_fields_per_type, default 15)
dotnet_diagnostic.SQR0004.severity = error # type name must be at most 40 chars
dotnet_diagnostic.SQR0005.severity = error # method name must be at most 40 chars
dotnet_diagnostic.SQR0006.severity = error # field name must be at most 40 chars
dotnet_diagnostic.SQR0007.severity = error # type name must not repeat its namespace segment
dotnet_diagnostic.SQR0008.severity = error # multiline embedded loop bodies (except nested loops) must use braces
dotnet_diagnostic.SQR0010.severity = error # skips multiline if/else/using/lock embedded bodies (only single-line bodies gated)
dotnet_diagnostic.SQR0012.severity = error # prefer ==/!= over is/is not patterns for null checks (reverses MA0142/MA0148/MA0149)
dotnet_diagnostic.SQR0013.severity = error # prefer == over is for constant comparisons
dotnet_diagnostic.SQR0014.severity = error # prefer != over is-not for constant comparisons
dotnet_diagnostic.SQR0017.severity = error # forbid TestContext.Current.CancellationToken; use DefaultCancellationToken from base test classes
dotnet_diagnostic.SQR0018.severity = error # multiline embedded if/else-if/else bodies (except nested ifs) must use braces
dotnet_diagnostic.SQR0009.severity = warning # drop named args passed in declaration order (prefer positional)
dotnet_diagnostic.SQR0011.severity = warning # omit args equal to the parameter default
dotnet_diagnostic.SQR0021.severity = warning # prefer ArgumentException throw helpers over manual guards
dotnet_diagnostic.SQR0022.severity = warning # TimeSpan range guards must route the throw through a throw-helper method (BCL ThrowIf* require INumberBase<T>; use a project helper)
dotnet_diagnostic.SQR0023.severity = warning # prefer ArgumentNullException.ThrowIfNull over null-coalescing throw
dotnet_diagnostic.SQR0024.severity = warning # prefer a throw-helper method over null-coalescing throw

# ===========================================================================
# StyleCop analyzers (SA*)
# ===========================================================================
dotnet_diagnostic.SA1101.severity = none # prefix local calls with this - disabled
dotnet_diagnostic.SA1124.severity = error # do not use regions
dotnet_diagnostic.SA1134.severity = error # each attribute on its own line
dotnet_diagnostic.SA1200.severity = none # using directives placement
dotnet_diagnostic.SA1202.severity = error # elements should be ordered by access (private after public/internal/protected)
dotnet_diagnostic.SA1309.severity = none # allow leading underscore fields
dotnet_diagnostic.SA1503.severity = none # always-require-braces conflicts with nested-loop no-braces style
dotnet_diagnostic.SA1519.severity = none # multi-line-child braces conflict with nested-loop no-braces style
dotnet_diagnostic.SA1520.severity = error # if/else siblings must use braces consistently (multi-statement if => braced else)
dotnet_diagnostic.SA1600.severity = none # missing XML comment for publicly visible type/member
dotnet_diagnostic.SA1633.severity = none # file header

# ===========================================================================
# Roslynator analyzers (RCS*)
# ===========================================================================
dotnet_analyzer_diagnostic.category-roslynator.severity = warning # all rules at warning+ so they appear in dotnet build (TreatWarningsAsErrors => error)
dotnet_diagnostic.RCS1001.severity = none # brace rules conflict with SA1520 / nested-loop style
dotnet_diagnostic.RCS1002.severity = none # remove braces (disabled: SQR0008/SQR0018 require them on multiline bodies)
dotnet_diagnostic.RCS1003.severity = none # add braces to multiline if-else (disabled: same conflict as RCS1002)
dotnet_diagnostic.RCS1004.severity = error # remove braces from single-line if-else (pairs with SQR0010)
dotnet_diagnostic.RCS1007.severity = none # add braces to multiline declarations (disabled: same conflict as RCS1002)
dotnet_diagnostic.RCS1021.severity = none # expression-bodied lambda makes XUnit box the value inside an assert
dotnet_diagnostic.RCS1069.severity = none # remove unnecessary case label conflicts with exhaustive switch style
dotnet_diagnostic.RCS1134.severity = none # remove redundant statement conflicts with explicit control-flow in some methods
dotnet_diagnostic.RCS1217.severity = none # convert interpolated string to concatenation

# ===========================================================================
# Microsoft code analysis (CA*) — reliability / disposal / performance / usage
# ===========================================================================
dotnet_diagnostic.CA1816.severity = error # dispose methods should call base
dotnet_diagnostic.CA1822.severity = error # mark members as static
dotnet_diagnostic.CA1823.severity = warning # unused private fields
dotnet_diagnostic.CA1825.severity = warning # avoid unnecessary zero-length array allocations
dotnet_diagnostic.CA1834.severity = error # use Span-based string append
dotnet_diagnostic.CA1845.severity = warning # use span-based overloads
dotnet_diagnostic.CA1852.severity = warning # seal types for performance
dotnet_diagnostic.CA1861.severity = error # use SearchValues for char search
dotnet_diagnostic.CA1869.severity = warning # cache and reuse Regex
dotnet_diagnostic.CA2000.severity = error # dispose objects before losing scope
dotnet_diagnostic.CA2012.severity = error # use ValueTask correctly
dotnet_diagnostic.CA2016.severity = warning # forward CancellationToken
dotnet_diagnostic.CA2201.severity = warning # do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = warning # instantiate argument exceptions correctly
dotnet_diagnostic.CA2213.severity = error # disposable fields should be disposed

# ===========================================================================
# Meziantou analyzers (MA*)
# ===========================================================================
dotnet_diagnostic.MA0003.severity = none # require named arguments when passing literals (conflicts with positional preference)
MA0015.consider_member_access_as_parameter = true # treat member access as a parameter for analyzer heuristics
dotnet_diagnostic.MA0016.severity = none # prefer collection abstraction over concrete types on public API (conflicts with zero-alloc)
dotnet_diagnostic.MA0038.severity = none # make instance method static (deprecated; prefer CA1822)
dotnet_diagnostic.MA0111.severity = none # prefer string.Create over FormattableString (conflicts with BannedSymbols.txt policy)
dotnet_diagnostic.MA0141.severity = none # reversed by SQR0012/SQR0013/SQR0014: plain ==/!=/is not preferred for null/constant checks
dotnet_diagnostic.MA0142.severity = none # reversed by SQR0012/SQR0013/SQR0014
dotnet_diagnostic.MA0148.severity = none # reversed by SQR0012/SQR0013/SQR0014
dotnet_diagnostic.MA0149.severity = none # reversed by SQR0012/SQR0013/SQR0014
dotnet_diagnostic.MA0157.severity = none # methods returning IAsyncEnumerable must not use Async suffix
dotnet_diagnostic.MA0174.severity = none # record declarations should use explicit record class
dotnet_diagnostic.MA0192.severity = none # use HasFlag instead of bitwise checks (adds allocations)
dotnet_diagnostic.MA0211.severity = none # require multi-line <summary> (single-line is fine for short members)
dotnet_diagnostic.MA0214.severity = none # use await instead of returning the task (returning the task is a valid optimization)
dotnet_diagnostic.MA0215.severity = warning # return the task instead of awaiting it (elide async state machine)

# ===========================================================================
# SonarAnalyzer (S*)
# ===========================================================================
dotnet_diagnostic.S107.severity = error # methods/constructors must not exceed 7 parameters (align local build with SonarCloud quality gate)
dotnet_diagnostic.S3267.severity = none # loops should be simplified with LINQ (this codebase prefers explicit loops)
dotnet_diagnostic.S4136.severity = none # method overloads should be grouped (conflicts with Rider file layout for object overrides)
dotnet_diagnostic.S6618.severity = none # prefer string.Create / FormattableString (conflicts with BannedSymbols.txt policy)

