# Top-most EditorConfig file
root = true # top-most EditorConfig; stops parent-dir lookup

# ===========================================================================
# Core file settings (apply to every tracked file)
# ===========================================================================
[*.{cs,csproj,props,targets,sln,json,md,yml,yaml,editorconfig,xml,txt,proto,ps1,runsettings,config,toml,http,svg,cshtml,razor,sql,sh,cmd,bat,mdc,csx}]
charset = utf-8 # file encoding
end_of_line = lf # normalize line endings to LF
indent_size = 4 # indent width in spaces
indent_style = space # use spaces, not tabs
insert_final_newline = true # ensure trailing newline at EOF
max_line_length = 180 # hard limit for line length
tab_width = 4 # visual tab width
trim_trailing_whitespace = true # strip trailing whitespace

# ===========================================================================
# C# language style + IDE code-style diagnostics
# ===========================================================================
csharp_new_line_before_open_brace = all # place open brace on its own line (Allman)
csharp_place_expr_method_on_single_line = if_owner_is_single_line # keep expression-bodied method on one line only if owner fits
csharp_prefer_braces = false # omit braces for single embedded statements (incl nested loops); keep for multi-statement bodies (SQR0008). when_multiline/SA1519/RCS1001 would force braces
csharp_prefer_simple_using_statement = true:warning # prefer using declaration over using block
csharp_prefer_static_local_function = true:error # prefer static local functions
csharp_space_after_cast = false # no space after a cast
csharp_style_deconstructed_variable_declaration = true:warning # prefer deconstructed variable declaration
csharp_style_expression_bodied_accessors = when_on_single_line:warning # expression body for accessors when single line
csharp_style_expression_bodied_indexers = when_on_single_line:warning # expression body for indexers when single line
csharp_style_expression_bodied_local_functions = false:warning # no expression body for local functions
csharp_style_expression_bodied_methods = when_on_single_line:warning # expression body for methods when single line
csharp_style_expression_bodied_operators = false:warning # no expression body for operators
csharp_style_expression_bodied_properties = when_on_single_line:warning # expression body for properties when single line
csharp_style_inlined_variable_declaration = true:warning # prefer inlined variable declaration
csharp_style_namespace_declarations = file_scoped # use file-scoped namespaces
csharp_style_pattern_matching_over_as_with_null_check = true:warning # pattern match over as plus null check
csharp_style_pattern_matching_over_is_with_cast_check = true:warning # pattern match over is plus cast check
csharp_style_prefer_not_pattern = true:warning # prefer not pattern
csharp_style_prefer_pattern_matching = true:warning # prefer pattern matching
csharp_style_prefer_switch_expression = true:warning # prefer switch expression
csharp_style_unused_value_assignment_preference = discard_variable:warning # prefer discard for unused assignments
csharp_style_unused_value_expression_statement_preference = discard_variable:warning # prefer explicit discard when intentionally ignoring a value
csharp_style_var_elsewhere = true:suggestion # use var where type not apparent
csharp_style_var_for_built_in_types = true:warning # use latest C# style rules
csharp_style_var_when_type_is_apparent = true:suggestion # use var when type apparent

dotnet_diagnostic.CA1510.severity = warning # throw helpers instead of multi-line ArgumentNullException/ObjectDisposedException blocks
dotnet_diagnostic.CA1511.severity = warning # use ArgumentException throw helper
dotnet_diagnostic.CA1512.severity = warning # use InvalidOperationException throw helper
dotnet_diagnostic.CA1513.severity = warning # use ObjectDisposedException throw helper
dotnet_diagnostic.IDE0003.severity = warning # suppresses redundant this. qualification
dotnet_diagnostic.IDE0005.severity = error # remove unused using directives (fails build via EnforceCodeStyleInBuild)
dotnet_diagnostic.IDE0007.severity = warning # use implicit type (var) where applicable
dotnet_diagnostic.IDE0011.severity = error # IDE0011 unreliable at omitting braces when csharp_prefer_braces=false; SQR0010 is the build gate for single-line bodies
dotnet_diagnostic.IDE0017.severity = warning # use object initializers
dotnet_diagnostic.IDE0018.severity = warning # use inlined variable declaration
dotnet_diagnostic.IDE0019.severity = warning # pattern match over as with null check
dotnet_diagnostic.IDE0020.severity = warning # pattern match over is with cast check
dotnet_diagnostic.IDE0021.severity = warning # use expression body for constructors
dotnet_diagnostic.IDE0022.severity = warning # use expression body for methods
dotnet_diagnostic.IDE0023.severity = warning # use expression body for conversion operators
dotnet_diagnostic.IDE0025.severity = warning # use expression body for properties
dotnet_diagnostic.IDE0026.severity = warning # use expression body for indexers
dotnet_diagnostic.IDE0027.severity = warning # use expression body for accessors
dotnet_diagnostic.IDE0028.severity = warning # use collection initializers
dotnet_diagnostic.IDE0029.severity = warning # simplify null check with coalesce expression
dotnet_diagnostic.IDE0031.severity = warning # use null propagation (?.)
dotnet_diagnostic.IDE0041.severity = warning # use is null / is not null check
dotnet_diagnostic.IDE0045.severity = none # do not convert if statement to switch statement
dotnet_diagnostic.IDE0055.severity = error # enforce code-style formatting in build
dotnet_diagnostic.IDE0063.severity = warning # use simple using statement
dotnet_diagnostic.IDE0066.severity = warning # use switch expression
dotnet_diagnostic.IDE0074.severity = warning # use coalesce compound assignment
dotnet_diagnostic.IDE0078.severity = none # use pattern matching combinators (and/or)
dotnet_diagnostic.IDE0083.severity = warning # use not pattern
dotnet_diagnostic.IDE0090.severity = warning # use target-typed new (simplify new expression)
dotnet_diagnostic.IDE0130.severity = error # namespace should match folder
dotnet_diagnostic.IDE0160.severity = none # no block-scoped namespace preference
dotnet_diagnostic.IDE0161.severity = error # use file-scoped namespaces
dotnet_diagnostic.IDE0290.severity = none # use primary constructor
dotnet_diagnostic.IDE0300.severity = warning # use collection expression for array
dotnet_diagnostic.IDE0301.severity = warning # use collection expression for empty
dotnet_diagnostic.IDE0305.severity = warning # use collection expression for fluent

dotnet_style_collection_initializer = true:warning # use collection initializer
dotnet_style_coalesce_expression = true:warning # use coalesce expression
dotnet_style_null_propagation = true:warning # use null propagation
dotnet_style_object_initializer = true:warning # use object initializer
dotnet_style_prefer_collection_expression = when_types_exactly_match:warning # use collection expression when types match
dotnet_style_prefer_compound_assignment = true:warning # use compound assignment
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning # use is null check over reference equality
dotnet_style_qualification_for_event = false:warning # do not qualify events with this.
dotnet_style_qualification_for_field = false:warning # omit redundant this. (IDE0003 warning fails build under TreatWarningsAsErrors); SA1101 stays none
dotnet_style_qualification_for_method = false:warning # do not qualify methods with this.
dotnet_style_qualification_for_property = false:warning # do not qualify properties with this.
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion # nullable/language enforced via MSBuild too

resharper_arrange_this_qualifier_highlighting = error # legacy alias of arrange_this_qualifier (Rider deprecates redundant_this_qualifier)
resharper_instance_members_qualify_members = none # do not require this. qualification (Rider)

# ===========================================================================
# Argument style (positional vs named)
# ===========================================================================
# Prefer positional args; in-order named arguments fail the build.
resharper_arguments_literal = positional # Rider: positional args for literals
resharper_arguments_other = positional # Rider: positional args for other
resharper_arguments_string_literal = positional # Rider: positional args for string literals
resharper_arguments_style_anonymous_function_highlighting = error # flag anonymous-function arg style
resharper_arguments_style_literal_highlighting = error # flag literal arg style
resharper_arguments_style_named_expression_highlighting = error # flag named-expression arg style
resharper_arguments_style_other_highlighting = error # flag other arg style
resharper_arguments_style_string_literal_highlighting = error # flag string-literal arg style
resharper_redundant_argument_default_value_highlighting = warning # parameter has same default value as another (Rider UI + SQR011 build gate)

# ===========================================================================
# Squirix analyzers (SQR*)
# ===========================================================================
dotnet_diagnostic.SQR0001.severity = error # outer for/foreach/while/do must omit braces when body is only a nested loop
dotnet_diagnostic.SQR0002.severity = error # design/naming limit (SQR0002-SQR0007); threshold via SQR0002.max_methods_per_type (default 20)
dotnet_diagnostic.SQR0003.severity = error # design/naming limit (SQR0002-SQR0007)
dotnet_diagnostic.SQR0004.severity = error # design/naming limit (SQR0002-SQR0007)
dotnet_diagnostic.SQR0005.severity = error # design/naming limit (SQR0002-SQR0007)
dotnet_diagnostic.SQR0006.severity = error # design/naming limit (SQR0002-SQR0007)
dotnet_diagnostic.SQR0007.severity = error # design / naming limits (SQR0002-SQR0007)
dotnet_diagnostic.SQR0008.severity = error # multiline embedded loop bodies (except nested loops) must use braces
dotnet_diagnostic.SQR0010.severity = error # skips multiline if/else/using/lock embedded bodies (only single-line bodies gated)
dotnet_diagnostic.SQR0012.severity = error # prefer ==/!= over is/is not patterns for null checks (reverses MA0142/MA0148/MA0149)
dotnet_diagnostic.SQR0013.severity = error # Squirix design/naming rule
dotnet_diagnostic.SQR0014.severity = error # Squirix design/naming rule
dotnet_diagnostic.SQR0017.severity = error # forbid TestContext.Current.CancellationToken; use DefaultCancellationToken from base test classes
dotnet_diagnostic.SQR0018.severity = error # multiline embedded if/else-if/else bodies (except nested ifs) must use braces
dotnet_diagnostic.SQR0009.severity = warning # Squirix rule (SQR0009)
dotnet_diagnostic.SQR0011.severity = warning # Squirix rule (SQR0011)

# ===========================================================================
# StyleCop analyzers (SA*)
# ===========================================================================
dotnet_diagnostic.SA1101.severity = none # prefix local calls with this - disabled
dotnet_diagnostic.SA1124.severity = error # do not use regions
dotnet_diagnostic.SA1134.severity = error # each attribute on its own line
dotnet_diagnostic.SA1200.severity = none # using directives placement
dotnet_diagnostic.SA1202.severity = error # elements should be ordered by access (private after public/internal/protected)
dotnet_diagnostic.SA1309.severity = none # allow leading underscore fields
dotnet_diagnostic.SA1503.severity = none # always-require-braces conflicts with nested-loop no-braces style
dotnet_diagnostic.SA1519.severity = none # multi-line-child braces conflict with nested-loop no-braces style
dotnet_diagnostic.SA1520.severity = error # if/else siblings must use braces consistently (multi-statement if => braced else)
dotnet_diagnostic.SA1600.severity = none # missing XML comment for publicly visible type/member
dotnet_diagnostic.SA1633.severity = none # file header

# ===========================================================================
# Roslynator analyzers (RCS*)
# ===========================================================================
dotnet_analyzer_diagnostic.category-roslynator.severity = warning # all rules at warning+ so they appear in dotnet build (TreatWarningsAsErrors => error)
dotnet_diagnostic.RCS1001.severity = none # brace rules conflict with SA1520 / nested-loop style
dotnet_diagnostic.RCS1002.severity = none # Roslynator rule disabled (RCS1002)
dotnet_diagnostic.RCS1003.severity = none # Roslynator rule disabled (RCS1003)
dotnet_diagnostic.RCS1004.severity = error # Roslynator rule (RCS1004)
dotnet_diagnostic.RCS1007.severity = none # Roslynator rule disabled (RCS1007)
dotnet_diagnostic.RCS1021.severity = none # expression-bodied lambda makes XUnit box the value inside an assert
dotnet_diagnostic.RCS1069.severity = none # remove unnecessary case label conflicts with exhaustive switch style
dotnet_diagnostic.RCS1134.severity = none # remove redundant statement conflicts with explicit control-flow in some methods
dotnet_diagnostic.RCS1217.severity = none # convert interpolated string to concatenation

# ===========================================================================
# Microsoft code analysis (CA*) — reliability / disposal / performance / usage
# ===========================================================================
dotnet_diagnostic.CA1816.severity = error # dispose methods should call base
dotnet_diagnostic.CA1822.severity = error # mark members as static
dotnet_diagnostic.CA1823.severity = warning # unused private fields
dotnet_diagnostic.CA1825.severity = warning # avoid unnecessary zero-length array allocations
dotnet_diagnostic.CA1834.severity = error # use Span-based string append
dotnet_diagnostic.CA1845.severity = warning # use span-based overloads
dotnet_diagnostic.CA1852.severity = warning # seal types for performance
dotnet_diagnostic.CA1861.severity = error # use SearchValues for char search
dotnet_diagnostic.CA1869.severity = warning # cache and reuse Regex
dotnet_diagnostic.CA2000.severity = error # dispose objects before losing scope
dotnet_diagnostic.CA2012.severity = error # use ValueTask correctly
dotnet_diagnostic.CA2016.severity = warning # forward CancellationToken
dotnet_diagnostic.CA2201.severity = warning # do not raise reserved exception types
dotnet_diagnostic.CA2208.severity = warning # instantiate argument exceptions correctly
dotnet_diagnostic.CA2213.severity = error # disposable fields should be disposed

# ===========================================================================
# Meziantou analyzers (MA*)
# ===========================================================================
dotnet_diagnostic.MA0003.severity = none # require named arguments when passing literals (conflicts with positional preference)
MA0015.consider_member_access_as_parameter = true # treat member access as a parameter for analyzer heuristics
dotnet_diagnostic.MA0016.severity = none # prefer collection abstraction over concrete types on public API (conflicts with zero-alloc)
dotnet_diagnostic.MA0038.severity = none # make instance method static (deprecated; prefer CA1822)
dotnet_diagnostic.MA0111.severity = none # prefer string.Create over FormattableString (conflicts with BannedSymbols.txt policy)
dotnet_diagnostic.MA0141.severity = none # reversed by SQR0012/SQR0013/SQR0014: plain ==/!=/is not preferred for null/constant checks
dotnet_diagnostic.MA0142.severity = none # reversed by SQR0012/SQR0013/SQR0014
dotnet_diagnostic.MA0148.severity = none # reversed by SQR0012/SQR0013/SQR0014
dotnet_diagnostic.MA0149.severity = none # reversed by SQR0012/SQR0013/SQR0014
dotnet_diagnostic.MA0157.severity = none # methods returning IAsyncEnumerable must not use Async suffix
dotnet_diagnostic.MA0174.severity = none # record declarations should use explicit record class
dotnet_diagnostic.MA0192.severity = none # use HasFlag instead of bitwise checks (adds allocations)
dotnet_diagnostic.MA0211.severity = none # require multi-line <summary> (single-line is fine for short members)
dotnet_diagnostic.MA0214.severity = none # use await instead of returning the task (returning the task is a valid optimization)
dotnet_diagnostic.MA0215.severity = warning # return the task instead of awaiting it (elide async state machine)

# ===========================================================================
# SonarAnalyzer (S*)
# ===========================================================================
dotnet_diagnostic.S3267.severity = none # loops should be simplified with LINQ (this codebase prefers explicit loops)
dotnet_diagnostic.S4136.severity = none # method overloads should be grouped (conflicts with Rider file layout for object overrides)
dotnet_diagnostic.S6618.severity = none # prefer string.Create / FormattableString (conflicts with BannedSymbols.txt policy)

# ===========================================================================
# Banned API symbols (RS*) — see BannedSymbols.txt
# ===========================================================================
# ECMA documentation IDs with full parameter lists are required; partial names are ignored silently.
# exclude_generated_code is in .globalconfig (EditorConfig does not apply to in-memory source generators).
dotnet_diagnostic.MA0076.severity = none # implicit culture ToString in interpolation (project standard: string interpolation)
dotnet_diagnostic.RS0030.severity = error # symbol has been banned
dotnet_diagnostic.RS0031.severity = error # symbol has been banned for use in declarations

# ===========================================================================
# ErrorProne.NET (EPC / ERP / EPS)
# ===========================================================================
# Only non-default severities: Info→warning, or enable rules that ship disabled.
# Do not use category-Performance bulk config (collides with CA18xx/CA186x and ZeroAlloc).
dotnet_diagnostic.EPC14.severity = warning # ConfigureAwait(false) call is redundant
dotnet_diagnostic.EPC15.severity = warning # ConfigureAwait(false) must be used
dotnet_diagnostic.EPC19.severity = warning # dispose CancellationTokenRegistration to avoid memory leaks
dotnet_diagnostic.EPC27.severity = warning # avoid async void methods
dotnet_diagnostic.EPC28.severity = warning # no ExcludeFromCodeCoverage on partial classes
dotnet_diagnostic.EPC29.severity = warning # ExcludeFromCodeCoverage should provide a message
dotnet_diagnostic.EPC32.severity = warning # TaskCompletionSource should use RunContinuationsAsynchronously
dotnet_diagnostic.EPC33.severity = warning # do not use Thread.Sleep in async methods
dotnet_diagnostic.EPC35.severity = warning # do not block unnecessarily in async methods
dotnet_diagnostic.EPC36.severity = warning # no async delegates with Task.Factory.StartNew + LongRunning
dotnet_diagnostic.EPC37.severity = warning # do not validate arguments in async methods
dotnet_diagnostic.EPC38.severity = warning # ErrorProne.NET correctness rule (EPC38)
dotnet_diagnostic.EPC39.severity = warning # ErrorProne.NET correctness rule (EPC39)
dotnet_diagnostic.EPC40.severity = warning # ErrorProne.NET correctness rule (EPC40)
dotnet_diagnostic.ERP041.severity = warning # EventSource class should be sealed
dotnet_diagnostic.EPS02.severity = warning # struct not readonly-friendly passed via in-parameter (defensive copy risk)
dotnet_diagnostic.EPS03.severity = warning # struct not readonly-friendly returned by ref readonly (defensive copy risk)
dotnet_diagnostic.EPS04.severity = warning # struct not readonly-friendly stored in ref readonly local (defensive copy risk)
dotnet_diagnostic.EPS05.severity = warning # struct could be passed using in-modifier for performance
dotnet_diagnostic.EPS07.severity = warning # hidden defensive copy of a readonly field (>=16-byte struct)
dotnet_diagnostic.EPS08.severity = warning # hidden defensive copy of an 'in' parameter (>=16-byte struct)
dotnet_diagnostic.EPS09.severity = warning # hidden copy of a ref readonly local

# ===========================================================================
# Microsoft.VisualStudio.Threading (VSTHRD) — promote hidden rule to warning
dotnet_diagnostic.VSTHRD111.severity = warning # use ConfigureAwait(bool) explicitly (production code only; tests excluded via [tests/**])

# ===========================================================================
# ZeroAlloc.Analyzers (ZA) — promote Info rules to warning (TreatWarningsAsErrors => error)
# ===========================================================================
# No single category-zeroalloc — rules use Performance.* subcategories (see ZeroAlloc DiagnosticCategories.cs).
# Do NOT use category-Performance: that also elevates CA18xx/CA186x NetAnalyzers in the same bucket.
dotnet_analyzer_diagnostic.category-Performance.Aot.severity = warning # ZeroAlloc: AOT allocation pitfalls
dotnet_analyzer_diagnostic.category-Performance.Async.severity = warning # ZeroAlloc: async allocation pitfalls
dotnet_analyzer_diagnostic.category-Performance.Boxing.severity = warning # ZeroAlloc: boxing allocations
dotnet_analyzer_diagnostic.category-Performance.Collections.severity = warning # ZeroAlloc: collection allocations
dotnet_analyzer_diagnostic.category-Performance.DataLayout.severity = warning # ZeroAlloc: data layout/size pitfalls
dotnet_analyzer_diagnostic.category-Performance.Delegates.severity = warning # ZeroAlloc: delegate allocations
dotnet_analyzer_diagnostic.category-Performance.Enums.severity = warning # ZeroAlloc: enum allocation pitfalls
dotnet_analyzer_diagnostic.category-Performance.Linq.severity = warning # ZeroAlloc: LINQ allocations
dotnet_analyzer_diagnostic.category-Performance.Logging.severity = warning # ZeroAlloc: logging allocations
dotnet_analyzer_diagnostic.category-Performance.Memory.severity = warning # ZeroAlloc: general memory allocations
dotnet_analyzer_diagnostic.category-Performance.Regex.severity = warning # ZeroAlloc: regex allocation pitfalls
dotnet_analyzer_diagnostic.category-Performance.Sealing.severity = warning # ZeroAlloc: sealing for JIT devirtualization
dotnet_analyzer_diagnostic.category-Performance.Serialization.severity = warning # ZeroAlloc: serialization allocations
dotnet_analyzer_diagnostic.category-Performance.Strings.severity = warning # ZeroAlloc: string allocations
dotnet_analyzer_diagnostic.category-Performance.ValueTypes.severity = warning # ZeroAlloc: value-type allocation pitfalls

# ===========================================================================
# xUnit.net analyzers (https://xunit.net/xunit.analyzers/rules/)
# ===========================================================================
# Promote Info/Hidden xUnit rules to warning (TreatWarningsAsErrors => error).
# Default-Error rules are omitted: they already fail the build.
dotnet_diagnostic.xUnit1004.severity = warning # test methods should not be skipped
dotnet_diagnostic.xUnit1033.severity = warning # class fixture should add constructor argument of type T
dotnet_diagnostic.xUnit1042.severity = warning # MemberData returns untyped data rows
dotnet_diagnostic.xUnit1044.severity = warning # avoid TheoryData type args that are not serializable
dotnet_diagnostic.xUnit1045.severity = warning # avoid TheoryData type args that might not be serializable
dotnet_diagnostic.xUnit1046.severity = warning # avoid TheoryDataRow args that are not serializable
dotnet_diagnostic.xUnit1047.severity = warning # avoid TheoryDataRow args that might not be serializable
dotnet_diagnostic.xUnit1050.severity = warning # ClassData returns untyped data rows
dotnet_diagnostic.xUnit2001.severity = warning # do not use invalid equality check
dotnet_diagnostic.xUnit2022.severity = warning # boolean assertions should not be negated
dotnet_diagnostic.xUnit2023.severity = warning # do not use collection methods for single-item collections
dotnet_diagnostic.xUnit2024.severity = warning # do not use boolean asserts for simple equality
dotnet_diagnostic.xUnit2025.severity = warning # boolean assertion can be simplified
dotnet_diagnostic.xUnit2032.severity = warning # assignable-from type assertions are confusingly named
dotnet_diagnostic.xUnit2033.severity = warning # use assertion return value instead of re-deriving it

# ===========================================================================
# Rider / ReSharper inspection severities (UI hints; do not fail dotnet build)
# ===========================================================================
resharper_arrange_redundant_parentheses_highlighting = none # do not flag redundant parentheses
resharper_bad_parens_line_breaks_highlighting = warning # flag bad parenthesis line breaks
resharper_braces_for_dowhile = not_required # do not require braces for do-while
resharper_braces_for_fixed = not_required # do not require braces for fixed
resharper_braces_for_for = not_required # do not require braces for for
resharper_braces_for_foreach = not_required # do not require braces for foreach
resharper_braces_for_ifelse = not_required # align with csharp_prefer_braces=false (omit braces for single embedded statements)
resharper_braces_for_lock = not_required # do not require braces for lock
resharper_braces_for_using = not_required # do not require braces for using
resharper_braces_for_while = not_required # do not require braces for while
resharper_braces_redundant = false # do not enable: would strip single-statement else, breaking SA1520
resharper_convert_if_statement_to_return_statement_highlighting = none # do not suggest if-to-return
resharper_convert_if_statement_to_switch_statement_highlighting = none # do not suggest if-to-switch
resharper_convert_switch_statement_to_switch_expression_highlighting = warning # suggest switch-to-expression
resharper_convert_to_primary_constructor_highlighting = none # primary constructors are not used in squirix
resharper_enforce_if_statement_braces_highlighting = none # do not enforce if braces
resharper_foreach_can_be_converted_to_query_using_another_get_enumerator_highlighting = none # do not suggest foreach-to-query
resharper_foreach_can_be_partly_converted_to_query_using_another_get_enumerator_highlighting = none # do not suggest partial foreach-to-query
resharper_for_can_be_converted_to_foreach_highlighting = none # do not suggest for-to-foreach
resharper_invert_if_highlighting = warning # suggest invert if
resharper_lambda_expression_can_be_made_static_highlighting = error # suggest static lambda
resharper_lambda_expression_must_be_static_highlighting = error # require static lambda
resharper_lambda_should_not_capture_context_highlighting = error # alloc-free delegates: static + RequireStaticDelegate
resharper_loop_can_be_converted_to_query_highlighting = none # do not suggest loop-to-query
resharper_loop_can_be_partly_converted_to_query_highlighting = none # do not suggest partial loop-to-query
resharper_member_can_be_private_global_highlighting = warning # suggest member can be private (global)
resharper_member_can_be_private_local_highlighting = warning # suggest member can be private (local)
resharper_redundant_empty_switch_section_highlighting = none # do not flag redundant empty switch
resharper_redundant_suppress_nullable_warning_expression_highlighting = warning # flag redundant nullable suppress
resharper_remove_redundant_braces_highlighting = none # do not remove redundant braces
resharper_suggest_var_or_type_built_in_types_highlighting = warning # align Rider var-for-built-in-types with csharp_style_var_for_built_in_types
resharper_switch_statement_handles_some_known_enum_values_with_default_highlighting = warning # flag switch missing enum cases with default
resharper_switch_statement_missing_some_enum_cases_no_default_highlighting = warning # flag switch missing enum cases no default
resharper_use_utf8_string_literal_highlighting = none # do not suggest utf8 literals
resharper_xmldoc_indent_text = zero_indent # no extra indent in XML doc

# ===========================================================================
# Visual Studio formatting keys (Rider understands them too)
# ===========================================================================
csharp_indent_case_contents_when_block = false # do not indent case block contents (VS default is true)

# ===========================================================================
# Rider / ReSharper C# formatting
# ===========================================================================
csharp_place_attribute_on_same_line = false # attributes on separate lines
csharp_place_field_attribute_on_same_line = false # attributes on separate lines (SA1134); cleanup must not merge [ThreadStatic] onto field
resharper_csharp_indent_nested_fixed_stmt = false # do not indent nested fixed
resharper_csharp_indent_nested_for_stmt = true # indent nested for
resharper_csharp_indent_nested_foreach_stmt = true # keep nested brace-less loops indented (Rider default false flattens them, trips Sonar S3973); using/lock/fixed chains stay flat
resharper_csharp_indent_nested_lock_stmt = false # do not indent nested lock
resharper_csharp_indent_nested_usings_stmt = false # do not indent nested using
resharper_csharp_indent_nested_while_stmt = true # indent nested while
resharper_csharp_keep_blank_lines_in_code = 1 # collapse consecutive blank lines (default is often 2)
resharper_csharp_keep_blank_lines_in_declarations = 1 # collapse consecutive blank lines in declarations
resharper_csharp_keep_existing_attribute_arrangement = false # reformat attribute arrangement
resharper_csharp_keep_existing_expr_member_arrangement = false # reformat expression-member arrangement
resharper_csharp_keep_existing_linebreaks = false # reformat line breaks
resharper_csharp_new_line_before_while = true # new line before while in do-while
resharper_csharp_place_constructor_initializer_on_same_line = false # constructor initializer on own line
resharper_csharp_place_expr_method_on_single_line = always # expression-bodied methods on one line
resharper_csharp_place_simple_embedded_statement_on_same_line = never # embedded statement on own line
resharper_csharp_place_type_constraints_on_same_line = false # type constraints on own line
resharper_csharp_wrap_after_declaration_lpar = false # no wrap after declaration lpar
resharper_csharp_wrap_after_invocation_lpar = false # no wrap after invocation lpar
resharper_csharp_wrap_arguments_style = wrap_if_long # wrap arguments if long
resharper_csharp_wrap_array_initializer_style = wrap_if_long # wrap array initializer if long
resharper_csharp_wrap_before_arrow_with_expressions = false # no wrap before arrow with expressions
resharper_csharp_wrap_before_declaration_rpar = false # no wrap before declaration rpar
resharper_csharp_wrap_before_first_method_call = false # no wrap before first method call
resharper_csharp_wrap_before_invocation_rpar = false # no wrap before invocation rpar
resharper_csharp_wrap_before_linq_expression = false # no wrap before LINQ expression
resharper_csharp_wrap_chained_method_calls = wrap_if_long # wrap chained calls if long
resharper_csharp_wrap_extends_list_style = wrap_if_long # wrap extends list if long
resharper_csharp_wrap_linq_expressions = wrap_if_long # wrap LINQ expressions if long
resharper_csharp_wrap_multiple_type_parameter_constraints_style = chop_always # always chop multiple constraints
resharper_csharp_wrap_object_and_collection_initializer_style = wrap_if_long # wrap initializer if long
resharper_csharp_wrap_parameters_style = wrap_if_long # wrap parameters if long
resharper_csharp_wrap_ternary_expr_style = wrap_if_long # wrap ternary if long

# ===========================================================================
# Scoped overrides
# ===========================================================================
[tools/**]
dotnet_diagnostic.MA0047.severity = none # Types must be declared inside a namespace (file-based scripts use top-level statements)
dotnet_diagnostic.MA0048.severity = none # File name must match the primary type name (script file names differ from inline types)
dotnet_diagnostic.MA0051.severity = none # Method exceeds configured line/statement limits (verify/pack scripts are intentionally long)
dotnet_diagnostic.RCS1110.severity = none # Declare type inside namespace (inline helper types in file-based scripts)
dotnet_diagnostic.ZA0901.severity = none # Seal class for JIT devirtualization (implicit Program from top-level statements cannot be sealed)

[examples/**]
dotnet_diagnostic.MA0048.severity = none # File name must match the primary type name (script file names differ from inline types)
dotnet_diagnostic.ZA0901.severity = none # Seal class for JIT devirtualization (implicit Program from top-level statements cannot be sealed)

[{tests,benchmarks}/**]
dotnet_diagnostic.SA1615.severity = none # Element return value should be documented (async tests/benchmarks return Task; boilerplate <returns> is redundant)

[tests/**]
dotnet_diagnostic.VSTHRD111.severity = none # VSTHRD111 (ConfigureAwait(bool)) targets production code; test classes with [Fact] are excluded

[**/{AsyncAssert,NodeAsyncAssert}.cs]
dotnet_diagnostic.VSTHRD003.severity = none # The closure-free exception assertions exist to observe an operation the caller already started

[**/*Grpc.cs]
dotnet_diagnostic.SA1518.severity = none # StyleCop: line endings at EOF must match settings (disabled for generated gRPC files)

[**/XunitAutoGeneratedEntryPoint.cs]
dotnet_diagnostic.RS0030.severity = none # generated entry point may call banned APIs
dotnet_diagnostic.RS0031.severity = none # generated entry point may call banned APIs (declarations)

[**/*.g.cs]
dotnet_diagnostic.EPC29.severity = none # Generated sources often use bare [ExcludeFromCodeCoverage] without justification
dotnet_diagnostic.RS0030.severity = none # Source generators (System.Text.Json, gRPC, etc.) may call banned APIs such as String.Format
dotnet_diagnostic.RS0031.severity = none # source generators may call banned APIs such as String.Format

[**/obj/**]
dotnet_diagnostic.EPC29.severity = none # MSBuild intermediate output (source generators, gRPC, JSON context, etc.)
dotnet_diagnostic.RS0030.severity = none # source generators may call banned APIs such as String.Format
dotnet_diagnostic.RS0031.severity = none # source generators may call banned APIs such as String.Format
