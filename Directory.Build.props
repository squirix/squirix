<Project>
    <PropertyGroup Label="Squirix NuGet">
        <SquirixPackageVersion>0.1.0-preview.8</SquirixPackageVersion>
        <SquirixAssemblyVersion>0.1.0.0</SquirixAssemblyVersion>
        <AssemblyVersion>$(SquirixAssemblyVersion)</AssemblyVersion>
        <FileVersion>$(SquirixAssemblyVersion)</FileVersion>
    </PropertyGroup>

    <PropertyGroup Label="Build">
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <DebugType>portable</DebugType>
        <LangVersion>preview</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DefineConstants>$(DefineConstants);CODE_ANALYSIS</DefineConstants>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <PropertyGroup Label="Analyzers">
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <MeziantouAnalysisMode>all-errors</MeziantouAnalysisMode>
    </PropertyGroup>

    <!-- Analysis shards. CI can spread the analyzed build over several runners by passing
         -p:SquirixAnalysisShard=<name>: only the projects of that shard run analyzers and code-style
         enforcement, the projects they reference compile without them. A project belongs to the
         `default` shard unless it is claimed below, so a new project is analyzed without being listed
         anywhere. Without the property (local builds, the IDE, packaging) every project is analyzed.
         A project may belong to several shards (a list), each running part of its analyzers (see below).
         The shard names are listed in SquirixAnalysisShards and in the CI job that runs one build per shard. -->
    <PropertyGroup Label="AnalysisShards">
        <SquirixAnalysisShards>default;server;server-unit-tests-1;server-unit-tests-2;server-tests</SquirixAnalysisShards>
        <SquirixProjectAnalysisShard>default</SquirixProjectAnalysisShard>
        <!-- Squirix.Server alone: in `default` its analysis delayed every project there that references it. -->
        <SquirixProjectAnalysisShard Condition="'$(MSBuildProjectName)' == 'Squirix.Server'">server</SquirixProjectAnalysisShard>
        <!-- Squirix.Server.UnitTests in two shards: its analyzers alone took a whole analysis job, so each shard runs half of them. -->
        <SquirixProjectAnalysisShard Condition="'$(MSBuildProjectName)' == 'Squirix.Server.UnitTests'">server-unit-tests-1;server-unit-tests-2</SquirixProjectAnalysisShard>
        <SquirixProjectAnalysisShard Condition="'$(MSBuildProjectName)' == 'Squirix.Server.TestKit' Or '$(MSBuildProjectName)' == 'Squirix.Server.IntegrationTests' Or '$(MSBuildProjectName)' == 'Squirix.Server.SmokeTests' Or '$(MSBuildProjectName)' == 'Squirix.E2ETests'">server-tests</SquirixProjectAnalysisShard>
    </PropertyGroup>
    <PropertyGroup Label="AnalysisShardSelection" Condition="'$(SquirixAnalysisShard)' != '' And !$([System.String]::Copy(';$(SquirixProjectAnalysisShard);').Contains(';$(SquirixAnalysisShard);'))">
        <RunAnalyzers>false</RunAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>
    <!-- The halves of the Squirix.Server.UnitTests analyzers. SquirixDroppedAnalyzerPackages names the analyzer packages a shard
         leaves to the other one (see SquirixDropAnalyzerPackages); an analyzer neither half drops runs in both, so a new
         analyzer package is never skipped. A project in only one of the two shards keeps all its analyzers. -->
    <PropertyGroup Label="AnalysisShardFirstHalf" Condition="'$(SquirixAnalysisShard)' == 'server-unit-tests-1' And $([System.String]::Copy(';$(SquirixProjectAnalysisShard);').Contains(';server-unit-tests-1;server-unit-tests-2;'))">
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <SquirixDroppedAnalyzerPackages>Microsoft.CodeAnalysis.NetAnalyzers;StyleCopNext.Analyzers;Roslynator.Analyzers;ErrorProne.NET.CoreAnalyzers;Microsoft.VisualStudio.Threading.Analyzers;ZeroAlloc.Analyzers;Microsoft.CodeAnalysis.BannedApiAnalyzers</SquirixDroppedAnalyzerPackages>
    </PropertyGroup>
    <!-- Meziantou stays with its rules off: its suppressors silence IDE0058, which this half reports. -->
    <PropertyGroup Label="AnalysisShardSecondHalf" Condition="'$(SquirixAnalysisShard)' == 'server-unit-tests-2' And $([System.String]::Copy(';$(SquirixProjectAnalysisShard);').Contains(';server-unit-tests-1;server-unit-tests-2;'))">
        <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
        <SquirixDroppedAnalyzerPackages>SonarAnalyzer.CSharp;Microsoft.NET.ILLink.Tasks;NsDepCop;squirix.analyzers</SquirixDroppedAnalyzerPackages>
    </PropertyGroup>
    <!-- A shard build only analyzes and its binaries are discarded, so TUnit need not generate the test registration code. -->
    <PropertyGroup Label="AnalysisShardGenerators" Condition="'$(SquirixAnalysisShard)' != ''">
        <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
    </PropertyGroup>

    <!-- SonarCloud analysis. The scanner adds its own analyzers to the build, and SonarCloud keeps only their
         issues: everything else is already enforced by the analysis shards. CI passes
         -p:SquirixSonarAnalysis=true to restore and build, so the scanner build runs the Sonar analyzers alone.
         The TUnit analyzers stay because their suppressors silence nullable warnings in the tests. -->
    <PropertyGroup Label="SonarAnalysis" Condition="'$(SquirixSonarAnalysis)' == 'true'">
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
        <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
    </PropertyGroup>

    <!-- File-based tools and examples (single .cs files run by dotnet run) reference production projects and build them on the way.
         The CI check of those files sets SquirixToolCheck=true, so only the file itself is analyzed there:
         the analysis shards already cover the referenced projects. -->
    <PropertyGroup Label="ToolCheck" Condition="'$(SquirixToolCheck)' == 'true' And '$(FileBasedProgram)' != 'true'">
        <RunAnalyzers>false</RunAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- Classify projects once; reuse in conditions below. -->
    <PropertyGroup Label="ProjectKind">
        <_NormalizedProjectDir>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))</_NormalizedProjectDir>
        <IsSquirixTestProject>false</IsSquirixTestProject>
        <IsSquirixBenchmarkProject>false</IsSquirixBenchmarkProject>
        <IsSquirixProductionProject>false</IsSquirixProductionProject>
        <IsSquirixProtocolModelProject>false</IsSquirixProtocolModelProject>
    </PropertyGroup>
    <PropertyGroup Condition="$(_NormalizedProjectDir.Contains('/src/squirix.protocol-model'))">
        <!-- Design-time Raft safety explorer; not a shipped product package. -->
        <IsSquirixProtocolModelProject>true</IsSquirixProtocolModelProject>
    </PropertyGroup>
    <PropertyGroup Condition="$(_NormalizedProjectDir.Contains('/src/')) And '$(IsSquirixProtocolModelProject)' != 'true'">
        <IsSquirixProductionProject>true</IsSquirixProductionProject>
    </PropertyGroup>
    <PropertyGroup Condition="$(_NormalizedProjectDir.Contains('/tests/'))">
        <IsSquirixTestProject>true</IsSquirixTestProject>
    </PropertyGroup>
    <PropertyGroup Condition="$(_NormalizedProjectDir.Contains('/benchmarks/'))">
        <IsSquirixBenchmarkProject>true</IsSquirixBenchmarkProject>
    </PropertyGroup>

    <!-- Rocks' generated mock docs emit malformed or unresolvable crefs (inherited members,
         tuple and generic arguments): CS1570/CS1574/CS1580/CS1584/CS1658. Path-scoped
         .editorconfig severities do not apply to compiler diagnostics from generated trees,
         and GenerateDocumentationFile must stay on for IDE0005 and StyleCop doc analysis, so
         these compiler codes are suppressed for test projects, which is where Rocks runs.
         TODO(Rocks): delete this PropertyGroup once doc-cref rendering is fixed upstream. -->
    <PropertyGroup Label="TestGeneratedCode" Condition="'$(IsSquirixTestProject)' == 'true'">
        <NoWarn>$(NoWarn);CS1570;CS1574;CS1580;CS1584;CS1658</NoWarn>
    </PropertyGroup>

    <!-- Squirix Roslyn analyzers (consumed from NuGet; see Directory.Packages.props). -->
    <ItemGroup Label="SquirixAnalyzers" Condition="'$(SquirixSonarAnalysis)' != 'true'">
        <PackageReference Include="squirix.analyzers" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Solution-wide third-party Roslyn analyzers. -->
    <ItemGroup Label="GlobalAnalyzers" Condition="'$(SquirixSonarAnalysis)' != 'true'">
        <PackageReference Include="ErrorProne.NET.CoreAnalyzers" PrivateAssets="all"/>
        <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all"/>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all"/>
        <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all"/>
        <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all"/>
        <PackageReference Include="StyleCopNext.Analyzers" PrivateAssets="all"/>
        <PackageReference Include="ZeroAlloc.Analyzers" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Namespace dependency rules for production packages under src/**, analyzers, protocol-model,
         all client-bucket tests/benchmarks, e2e harnesses, protocol-model tests, samples, and server
         tests under tests/squirix.server/**. -->
    <ItemGroup Label="NsDepCop" Condition="'$(SquirixSonarAnalysis)' != 'true' And (('$(IsSquirixProductionProject)' == 'true' And !$(_NormalizedProjectDir.Contains('/src/squirix.attributes'))) Or '$(IsSquirixProtocolModelProject)' == 'true' Or $(_NormalizedProjectDir.Contains('/tests/squirix/')) Or $(_NormalizedProjectDir.Contains('/tests/squirix.e2e.tests')) Or $(_NormalizedProjectDir.Contains('/tests/squirix.protocol-model')) Or $(_NormalizedProjectDir.Contains('/benchmarks/')) Or $(_NormalizedProjectDir.Contains('/samples/')) Or $(_NormalizedProjectDir.Contains('/tests/squirix.server/')))">
        <PackageReference Include="NsDepCop" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Library-specific analyzers: only tests/** and benchmarks/** (not src/**). -->
    <ItemGroup Label="TestAnalyzers" Condition="'$(IsSquirixTestProject)' == 'true'">
        <PackageReference Include="Rocks" PrivateAssets="all"/>
    </ItemGroup>

    <!-- MTP native code coverage for every test executable. -->
    <ItemGroup Label="MtpCodeCoverage" Condition="'$(IsSquirixTestProject)' == 'true' And $(MSBuildProjectName.Contains('Tests'))">
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
    </ItemGroup>

    <!-- BDN Roslyn rules ship inside BenchmarkDotNet.Annotations (BenchmarkDotNet excludes analyzer assets). -->
    <ItemGroup Label="BenchmarkAnalyzers" Condition="'$(IsSquirixBenchmarkProject)' == 'true'">
        <PackageReference Include="BenchmarkDotNet.Annotations" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup Label="AnalyzerConfig">
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false"/>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Reflection.txt" Visible="false"/>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Time.txt" Visible="false" Condition="'$(IsSquirixProductionProject)' == 'true'"/>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Visible="false"/>
    </ItemGroup>

    <!-- PVS-Studio project-level rules for every analyzed project (incl. tests).
         .pvsconfig itself excludes **/tests/**,**/samples/**,**/benchmarks/** so those
         trees stay out of findings; without this link, test projects had no rules file. -->
    <ItemGroup Label="PvsStudioConfig">
        <None Include="$(MSBuildThisFileDirectory).pvsconfig" Link=".pvsconfig"/>
        <!-- Solution-root suppress baseline; VS/plugin discovery needs a project item. -->
        <None Include="$(MSBuildThisFileDirectory)pvs-studio.suppress.json" Link="pvs-studio.suppress.json"/>
    </ItemGroup>

    <Target Name="SquirixDropAnalyzerPackages" BeforeTargets="CoreCompile" Condition="'$(SquirixDroppedAnalyzerPackages)' != ''">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy(';$(SquirixDroppedAnalyzerPackages);').Contains(';%(Analyzer.NuGetPackageId);'))"/>
        </ItemGroup>
    </Target>

    <!-- A shard name that no project belongs to would make that build analyze nothing, so it fails instead. -->
    <Target Name="SquirixValidateAnalysisShard" BeforeTargets="CoreCompile" Condition="'$(SquirixAnalysisShard)' != '' And !$([System.String]::Copy(';$(SquirixAnalysisShards);').Contains(';$(SquirixAnalysisShard);'))">
        <Error Text="Unknown analysis shard '$(SquirixAnalysisShard)'. Known shards: $(SquirixAnalysisShards)."/>
    </Target>

    <!-- Prints the analysis shard of this project. CI runs it on the solution so that the job of a shard other than `default`
         builds only that shard's projects (their references build with them): the list comes from the same property that
         turns the analyzers on, so moving a project into a shard above needs no CI change. -->
    <Target Name="SquirixPrintAnalysisShard">
        <ItemGroup>
            <_SquirixProjectAnalysisShard Include="$(SquirixProjectAnalysisShard)"/>
        </ItemGroup>
        <Message Importance="high" Text="squirix-analysis-shard|%(_SquirixProjectAnalysisShard.Identity)|$(MSBuildProjectFullPath)"/>
        <Message Importance="high" Text="squirix-analysis-shards|$(SquirixAnalysisShards)"/>
    </Target>
</Project>
